# 统一换行符规范：仓库内一律以 LF 存储，避免 Windows/Mac 间行尾差异。
# text 文件按内容检测，必要时自动转 LF；.sh 脚本强制 LF（防止 Linux 上 \r 报错）。

* text=auto

# shell 脚本：强制 LF（服务器上按可执行脚本运行）
*.sh text eol=lf

# 二进制文件：不做任何行尾/内容转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.key binary
*.pem binary
*.xdb binary
