###

# 1. 微信登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "code": "081testcode"
}

###

# 2. 登录 - 缺少 code 参数
POST {{baseUrl}}/auth/login
Content-Type: application/json

{}

###

# 3. 获取用户信息（需认证）
GET {{baseUrl}}/user/profile
Authorization: Bearer {{token}}

###

# 4. 无 token 访问（应返回 401）
GET {{baseUrl}}/user/profile

###

# 5. 错误 token
GET {{baseUrl}}/user/profile
Authorization: Bearer invalid_token_xxx

###

# ============================================================
# 股票行情接口
# ============================================================

# 6. 分钟K线 - 5分钟
GET {{baseUrl}}/stock/000001/klines?scale=5&count=1

###

# 7. 分钟K线 - 15分钟
GET {{baseUrl}}/stock/000001/klines?scale=15&count=5

###

# 8. 分钟K线 - 30分钟
GET {{baseUrl}}/stock/000001/klines?scale=30&count=5

###

# 9. 分钟K线 - 60分钟
GET {{baseUrl}}/stock/000001/klines?scale=60&count=5

###

# 10. 日线 - 最近 10 天
GET {{baseUrl}}/stock/600519/klines?scale=240&count=10

###

# 11. 日线 - 默认 100 条（不传 count）
GET {{baseUrl}}/stock/000858/klines?scale=240

###

# 12. 实时行情 - 平安银行
GET {{baseUrl}}/stock/000001/quote

###

# 13. 实时行情 - 贵州茅台
GET {{baseUrl}}/stock/600519/quote

###

# 14. 批量行情 - 3只
GET {{baseUrl}}/stock/quotes?codes=000001,600519,000858

###

# 15. 批量行情 - 5只（含创业板、科创板）
GET {{baseUrl}}/stock/quotes?codes=000001,600519,000858,300750,688981

###

# 16. 缺少 scale 参数（应返回 400）
GET {{baseUrl}}/stock/000001/klines

###

# 17. scale 值非法（应能容错）
GET {{baseUrl}}/stock/000001/klines?scale=999

###

# 18. 股票代码不存在
GET {{baseUrl}}/stock/999999/quote

###

# 19. 批量行情 - 空 codes（应返回 400）
GET {{baseUrl}}/stock/quotes

###

# 20. 批量行情 - 超过 50 只（应返回 400）
GET {{baseUrl}}/stock/quotes?codes=000001,000002,000003,000004,000005,000006,000007,000008,000009,000010,000011,000012,000013,000014,000015,000016,000017,000018,000019,000020,000021,000022,000023,000024,000025,000026,000027,000028,000029,000030,000031,000032,000033,000034,000035,000036,000037,000038,000039,000040,000041,000042,000043,000044,000045,000046,000047,000048,000049,000050,000051

###

# ============================================================
# 概念板块接口
# ============================================================

# 21. 概念板块列表 - 前10
GET {{baseUrl}}/sector/boards?top=10

###

# 22. 概念板块列表 - 默认20
GET {{baseUrl}}/sector/boards

###

# 23. 板块日K线 - 移动支付
GET {{baseUrl}}/sector/board/885333/klines?count=5

###

# 24. 板块日K线 - 人工智能
GET {{baseUrl}}/sector/board/885597/klines?count=3

###

# 25. 板块成分股 - 移动支付(cid=300188)
GET {{baseUrl}}/sector/members/300188

###

# 26. 板块成分股 - 人工智能(cid=301050)
GET {{baseUrl}}/sector/members/301050

###

# 27. 板块K线 - 不存在的板块代码
GET {{baseUrl}}/sector/board/999999/klines

###

# 28. 板块成分股 - 无效cid
GET {{baseUrl}}/sector/members/abc
