###

# 1. 微信登录
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "code": "081testcode"
}

###

# 2. 登录 - 缺少 code 参数
POST {{baseUrl}}/auth/login
Content-Type: application/json

{}

###

# 3. 获取用户信息（需认证）
GET {{baseUrl}}/user/profile
Authorization: Bearer {{token}}

###

# 4. 无 token 访问（应返回 401）
GET {{baseUrl}}/user/profile

###

# 5. 错误 token
GET {{baseUrl}}/user/profile
Authorization: Bearer invalid_token_xxx
