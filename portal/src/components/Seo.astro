---
/**
 * SEO 元信息组件：统一的 title / description / canonical / OG / Twitter / JSON-LD 输出。
 * - canonical 与 OG url 保留尾斜杠（站点 trailingSlash: 'always'，与真实 URL 一致）；
 * - 传 breadcrumb 自动生成 BreadcrumbList 结构化数据；
 * - 分享配图默认取 public/og.png（1200×630 大图）。
 * 用法：<Seo slot="head" title="..." description="..." />（放在 Base 布局内）。
 */
import { APP_NAME, ORG, SITE_DESCRIPTION, SITE_LANG, SITE_URL } from '../config/site'

interface Props {
  title: string
  description: string
  /** 页面路径（以 / 开头），用于 canonical 与 OG url；默认取当前路径 */
  path?: string
  /** 结构化数据（JSON-LD 对象数组），额外的组织/面包屑等由本组件自动补全 */
  jsonLd?: object[]
  /** 分享配图（public/ 下路径，默认 /og.png） */
  image?: string
  keywords?: string
  /** 面包屑：[{ name: '首页', path: '/' }, { name: '全球行情', path: '/global/' }] */
  breadcrumb?: { name: string; path: string }[]
}

const {
  title,
  description,
  path = Astro.url.pathname,
  jsonLd = [],
  image = '/og.png',
  keywords,
  breadcrumb,
} = Astro.props

// canonical 保留尾斜杠，与站点真实 URL 一致
const canonical = new URL(path, SITE_URL).toString()
const ogUrl = canonical
const ogImage = new URL(image, SITE_URL).toString()

const htmlTitle = title.includes(APP_NAME) ? title : `${title} - ${APP_NAME}`

// 自动补充：Organization（组织）+ BreadcrumbList（路径）
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ORG.name,
  alternateName: APP_NAME,
  url: SITE_URL,
  logo: new URL('/logo.png', SITE_URL).toString(),
  description: SITE_DESCRIPTION,
  areaServed: 'CN',
  address: {
    '@type': 'PostalAddress',
    addressLocality: '杭州',
    addressRegion: '浙江',
    addressCountry: 'CN',
  },
}

const breadcrumbJsonLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        item: new URL(item.path, SITE_URL).toString(),
      })),
    }
  : null

const allJsonLd = [...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []), orgJsonLd, ...jsonLd]
---

<title>{htmlTitle}</title>
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="applicable-device" content="pc,mobile" />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={APP_NAME} />
<meta property="og:title" content={htmlTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:locale" content={SITE_LANG} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={htmlTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  allJsonLd.map((obj) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(obj)} />
  ))
}
