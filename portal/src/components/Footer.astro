---
/**
 * 全站页脚：品牌简介 + 导航 + 免责声明固定块（合规要求，全站可见）。
 */
import { APP_NAME, APP_TAGLINE, DISCLAIMER, LOGO_IMAGE } from '../config/site'
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <a class="brand" href="/" aria-label={`${APP_NAME} 首页`}>
          <img class="brand-logo" src={LOGO_IMAGE} alt={APP_NAME} width="32" height="32" />
          <span>{APP_NAME}</span>
        </a>
        <p style="font-size: 14px; color: var(--text-secondary); margin-top: 12px">
          {APP_TAGLINE}
        </p>
      </div>
      <div class="footer-col">
        <h4>功能</h4>
        <ul>
          <li><a href="/global/">全球行情</a></li>
          <li><a href="/gold/">金店金价</a></li>
          <li><a href="/asia/">日韩行情</a></li>
          <li><a href="/metals/">有色金属</a></li>
          <li><a href="/news/">财经资讯</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>其他</h4>
        <ul>
          <li><a href="/features/">全部功能</a></li>
          <li><a href="/faq/">常见问题</a></li>
          <li><a href="/legal/">数据说明与免责声明</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-disclaimer">
      <strong>免责声明：</strong>
      {DISCLAIMER}
    </div>
    <div class="footer-copy">
      <div>浙江杭州</div>
      <div>© 2026 谷雨信息工作室 · Guyu Information Studio</div>
      <div class="footer-icp">
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer"
          >浙ICP备2026046536号</a
        >
        <span>·</span>
        <a
          href="https://www.beian.gov.cn/portal/registerSystemInfo?recordcode=33010802014589"
          target="_blank"
          rel="noopener noreferrer">浙公网安备33010802014589号</a
        >
      </div>
      <div class="footer-note">本网站仅作信息展示，不提供任何形式的投资建议或交易服务</div>
    </div>
  </div>
</footer>
