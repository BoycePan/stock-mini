---
/**
 * 全站页头：品牌 + 导航 + 主题切换。
 * 移动端为右侧抽屉导航（含遮罩），当前页高亮（aria-current）。
 */
import { APP_NAME, LOGO_IMAGE } from '../config/site'
import ThemeToggle from './ThemeToggle.astro'

const NAV_LINKS = [
  { href: '/', label: '首页' },
  { href: '/global/', label: '全球行情' },
  { href: '/gold/', label: '金价' },
  { href: '/asia/', label: '日韩行情' },
  { href: '/metals/', label: '有色金属' },
  { href: '/news/', label: '财经资讯' },
  { href: '/features/', label: '全部功能' },
  { href: '/faq/', label: '常见问题' },
]

const currentPath = Astro.url.pathname
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${APP_NAME} 首页`}>
      <img class="brand-logo" src={LOGO_IMAGE} alt={APP_NAME} width="34" height="34" />
      <span>{APP_NAME}</span>
    </a>

    <nav class="nav" aria-label="主导航">
      <div class="nav-links" id="nav-links">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </div>
      <ThemeToggle />
      <button
        class="nav-toggle"
        type="button"
        aria-label="展开菜单"
        aria-expanded="false"
        aria-controls="nav-links"
        data-nav-toggle
      >
        ☰
      </button>
    </nav>
  </div>
  <button class="nav-scrim" type="button" aria-label="关闭菜单" data-nav-scrim></button>
</header>

<script>
  // 移动端抽屉菜单开合
  const toggle = document.querySelector('[data-nav-toggle]')
  const scrim = document.querySelector('[data-nav-scrim]')
  const links = document.getElementById('nav-links')
  const close = () => {
    links?.classList.remove('open')
    scrim?.classList.remove('open')
    toggle?.setAttribute('aria-expanded', 'false')
    document.body.style.overflow = ''
  }
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open') ?? false
    scrim?.classList.toggle('open', open)
    toggle.setAttribute('aria-expanded', String(open))
    document.body.style.overflow = open ? 'hidden' : ''
  })
  scrim?.addEventListener('click', close)
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close))
</script>
