---
/**
 * 常见问题页。
 */
import Base from '../../layouts/Base.astro'
import Seo from '../../components/Seo.astro'
import QrCta from '../../components/QrCta.astro'
import FaqItem from '../../components/FaqItem.astro'
import { FAQS } from '../../data/faq'

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
}
---

<Base>
  <Seo
    slot="head"
    title="常见问题：如何打开、是否收费、数据来源与免责声明"
    description="关于市场追踪助手小程序的常见问题：如何打开小程序、是否收费、数据来源、数据时效、深浅主题、K线与分时图，以及数据仅作参考的免责说明。"
    path="/faq/"
    keywords="常见问题,FAQ,免费,数据来源,免责声明,主题模式"
    jsonLd={[faqJsonLd]}
  />

  <section class="landing-hero">
    <div class="container">
      <h1>常见问题</h1>
      <p class="lead">关于小程序的使用、数据与合规问题，这里都有答案。</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="faq-list">
        {FAQS.map((item, index) => <FaqItem item={item} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <QrCta title="还有疑问？打开小程序试试" />
    </div>
  </section>
</Base>
