---
/**
 * 日韩行情落地页（SEO：日经225、KOSPI、韩元、日元）。
 * 事实来源：front/config/tabbar.ts（ASIA_INDICES / ASIA_KR_STOCKS / ASIA_JP_STOCKS / ASIA_RATES）。
 */
import Base from '../../layouts/Base.astro'
import Seo from '../../components/Seo.astro'
import QrCta from '../../components/QrCta.astro'

const asiaIndices = [
  { name: 'KOSPI', desc: '韩国综合指数' },
  { name: 'KOSDAQ', desc: '韩国创业板' },
  { name: '日经225', desc: '日本主要股指' },
  { name: 'TOPIX', desc: '东证股价指数' },
  { name: '越南胡志明', desc: 'VNINDEX' },
  { name: '孟买SENSEX', desc: '印度主要股指' },
]

const krStocks = [
  '三星电子',
  'SK海力士',
  'LG新能源',
  'LG电子',
  'NAVER',
  '现代汽车',
  '赛尔群',
  'LG化学',
]
const jpStocks = ['东京电子', '发那科', '基恩士', '丰田', '索尼', '信越化学', '村田', '任天堂']

const rates = ['人民币/韩元', '人民币/日元', '美元/韩元', '美元/日元', '美元/离岸人民币']
---

<Base>
  <Seo
    slot="head"
    title="日韩行情：日经225、KOSPI、日韩个股与汇率一页看齐"
    description="看韩国KOSPI/KOSDAQ、日本日经225/TOPIX，以及三星电子、SK海力士、东京电子、丰田、任天堂等日韩龙头个股和人民币韩元/日元汇率，微信小程序免费看，支持深浅主题。"
    path="/asia/"
    keywords="日经225,KOSPI,韩国股市,日本股市,三星电子,SK海力士,汇率,韩元,日元,日韩行情"
    breadcrumb={[
      { name: '首页', path: '/' },
      { name: '日韩行情', path: '/asia/' },
    ]}
    jsonLd={[
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: '市场追踪助手',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'WeChat Mini Program',
        description: '免费看日韩指数、龙头个股与汇率的微信小程序，数据来自公开接口聚合，仅供参考。',
        inLanguage: 'zh-CN',
      },
    ]}
  />

  <section class="landing-hero">
    <div class="container">
      <span class="eyebrow">Asia Markets</span>
      <h1>日韩行情，一页看齐</h1>
      <p class="lead">韩国与日本指数、龙头个股、汇率集中在一个页面，亚洲市场动态尽收眼底。</p>
      <div class="tag-row">
        <span class="chip chip-up">日经225</span>
        <span class="chip chip-down">KOSPI</span>
        <span class="chip chip-up">三星电子</span>
        <span class="chip chip-down">SK海力士</span>
        <span class="chip chip-up">丰田</span>
        <span class="chip chip-down">美元/日元</span>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="grid-2">
        <div class="card reveal">
          <h3 style="margin-top: 0">📊 亚洲指数</h3>
          <table class="data-table">
            <tbody>
              {
                asiaIndices.map((item) => (
                  <tr>
                    <td style="font-weight: 600">{item.name}</td>
                    <td style="color: var(--text-muted)">{item.desc}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="card reveal" data-delay="1">
          <h3 style="margin-top: 0">🇰🇷 韩国个股</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
            {krStocks.map((name) => <span class="chip">{name}</span>)}
          </div>
          <h3>🇯🇵 日本个股</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
            {jpStocks.map((name) => <span class="chip">{name}</span>)}
          </div>
        </div>
      </div>

      <div class="card mt-32 reveal">
        <h3 style="margin-top: 0">💱 汇率</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
          {rates.map((name) => <span class="chip">{name}</span>)}
        </div>
        <p class="prose" style="margin-top: 16px">
          汇率与指数、个股在同一页面展示，无需在多个工具间切换。
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="reveal"><QrCta title="日韩指数、个股、汇率一页看齐" /></div>
    </div>
  </section>
</Base>
