---
/**
 * 404 页面。
 */
import Base from '../layouts/Base.astro'
import Seo from '../components/Seo.astro'
---

<Base>
  <Seo
    slot="head"
    title="页面不存在"
    description="您访问的页面不存在，返回首页继续浏览市场追踪助手小程序介绍。"
    path="/404"
  />
  <div class="notfound">
    <h1>404</h1>
    <p class="lead" style="margin: 0; color: var(--text-secondary)">
      您访问的页面不存在或已被移除。
    </p>
    <a class="btn btn-primary" href="/">返回首页</a>
  </div>
</Base>
