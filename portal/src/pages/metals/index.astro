---
/**
 * 有色金属落地页（SEO：黄金、白银、铜、稀土、钨）。
 * 事实来源：front/config/tabbar.ts（METALS / METAL_SECTIONS）。
 */
import Base from '../../layouts/Base.astro'
import Seo from '../../components/Seo.astro'
import QrCta from '../../components/QrCta.astro'

const precious = ['黄金', '白银']
const industrial = ['铜', '铝', '锌', '镍', '锡']
const minor = ['钨', '钼', '锗', '铟', '锑']
---

<Base>
  <Seo
    slot="head"
    title="有色金属行情：金银内外盘、铜铝锌镍锡、小金属一屏看齐"
    description="看黄金、白银内外盘（沪金/沪银 + COMEX），铜铝锌镍锡等工业金属，以及钨钼锗铟锑小金属（对应A股公司股价），微信小程序免费看，数据来自公开接口聚合。"
    path="/metals/"
    keywords="有色金属,黄金,白银,铜价,稀土,钨,钼,COMEX,期货"
    jsonLd={[
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: '市场追踪助手',
        applicationCategory: 'FinanceApplication',
        operatingSystem: 'WeChat Mini Program',
        description:
          '免费看有色金属行情（金银内外盘、工业金属、小金属）的微信小程序，数据来自公开接口聚合，仅供参考。',
        inLanguage: 'zh-CN',
      },
    ]}
  />

  <section class="landing-hero">
    <div class="container">
      <h1>有色金属行情，一屏看齐</h1>
      <p class="lead">金银内外盘同屏、工业金属、小金属全覆盖，还附带金店金价与上金所实物金。</p>
      <div class="tag-row">
        <span class="chip chip-up">COMEX黄金</span>
        <span class="chip chip-down">COMEX白银</span>
        <span class="chip chip-up">沪铜</span>
        <span class="chip chip-down">钨</span>
        <span class="chip chip-up">稀土</span>
        <span class="chip chip-down">镍</span>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="grid-2">
        <div class="card">
          <h3 style="margin-top: 0">🥇 金银 · 内外盘同屏</h3>
          <p class="prose">
            黄金、白银同时展示内盘（沪金主连 元/克、沪银主连 元/千克）与外盘（COMEX 美元/盎司），
            无需在不同软件间切换。
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
            {precious.map((name) => <span class="chip chip-up">{name}</span>)}
          </div>
        </div>

        <div class="card">
          <h3 style="margin-top: 0">🏭 工业金属</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
            {industrial.map((name) => <span class="chip">{name}</span>)}
          </div>
        </div>
      </div>

      <div class="card mt-32">
        <h3 style="margin-top: 0">⛏️ 小金属（钨钼锗铟锑）</h3>
        <p class="prose">
          钨、钼、锗、铟、锑暂无统一现货报价，小程序展示对应 A 股上市公司股价作为参考：
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px">
          {minor.map((name) => <span class="chip chip-down">{name}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <QrCta title="金银、工业金属、小金属一屏看齐" />
    </div>
  </section>
</Base>
