---
/**
 * 财经资讯落地页（SEO：财经新闻、股市资讯）。
 * 事实来源：front/pages/finance/index（快讯流 + 触底分页）、front/packageNews/pages/news*。
 */
import Base from '../../layouts/Base.astro'
import Seo from '../../components/Seo.astro'
import QrCta from '../../components/QrCta.astro'
---

<Base>
  <Seo
    slot="head"
    title="财经资讯：快讯流 + 新闻详情，免费看市场动态"
    description="微信小程序免费看财经快讯与新闻详情：快讯带「快讯」徽标，触底自动分页加载，新闻详情富文本展示，随时跟进A股、美股、全球市场动态。"
    path="/news/"
    keywords="财经新闻,股市资讯,财经快讯,市场动态,金融资讯,7x24快讯"
    breadcrumb={[
      { name: '首页', path: '/' },
      { name: '财经资讯', path: '/news/' },
    ]}
    jsonLd={[
      {
        '@context': 'https://schema.org',
        '@type': 'SoftwareApplication',
        name: '市场追踪助手',
        applicationCategory: 'NewsApplication',
        operatingSystem: 'WeChat Mini Program',
        description: '免费看财经快讯与新闻详情的微信小程序，数据来自公开接口聚合，仅供参考。',
        inLanguage: 'zh-CN',
      },
    ]}
  />

  <section class="landing-hero">
    <div class="container">
      <span class="eyebrow">News & Flow</span>
      <h1>财经资讯，随手刷</h1>
      <p class="lead">快讯流 + 新闻详情，随时跟进市场动态，快讯一眼识别，长文慢慢读。</p>
      <div class="tag-row">
        <span class="badge">快讯</span>
        <span class="chip chip-up">财经新闻</span>
        <span class="chip chip-down">股市资讯</span>
        <span class="chip chip-up">富文本详情</span>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="grid-2">
        <div class="card reveal">
          <h3 style="margin-top: 0">⚡ 快讯流</h3>
          <p class="prose">
            财经新闻以信息流形式呈现，时效性内容带「快讯」徽标，一眼识别值得先读的信息。
          </p>
        </div>
        <div class="card reveal" data-delay="1">
          <h3 style="margin-top: 0">📄 新闻详情</h3>
          <p class="prose">
            点击进入新闻详情，富文本排版阅读体验更舒适；列表触底自动分页加载，浏览不中断。
          </p>
        </div>
      </div>

      <div class="card mt-32 reveal">
        <h3 style="margin-top: 0">🔎 资讯与行情联动</h3>
        <p class="prose">
          在个股详情页还能查看该股的相关新闻与相关公告，行情与资讯对照着看，信息更完整。
        </p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="reveal"><QrCta title="财经资讯、行情联动，一屏看齐" /></div>
    </div>
  </section>
</Base>
