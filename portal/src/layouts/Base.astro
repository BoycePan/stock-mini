---
/**
 * 基础布局：全站页头（导航 + 主题切换）、渐变光斑背景、页脚（免责声明固定块）、
 * 主题防闪烁脚本（首帧前根据 localStorage / prefers-color-scheme 设置 data-theme）、
 * 滚动浮现 / 返回顶部 / 移动端悬浮 CTA 的共享脚本。
 * 页面通过 <Seo slot="head" /> 提供 title / description / OG / canonical / JSON-LD。
 */
import '../styles/global.css'
import { LOGO_IMAGE, SEO_VERIFICATION, SITE_URL } from '../config/site'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

// 站长平台验证 meta（仅当 site.ts 填了 token 才输出，留空不产生任何额外标签）
const verificationMetas = [
  SEO_VERIFICATION.google && { name: 'google-site-verification', content: SEO_VERIFICATION.google },
  SEO_VERIFICATION.baidu && { name: 'baidu-site-verification', content: SEO_VERIFICATION.baidu },
  SEO_VERIFICATION.bing && { name: 'msvalidate.01', content: SEO_VERIFICATION.bing },
].filter(Boolean) as { name: string; content: string }[]
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#eef3f8" />
    <link rel="icon" type="image/png" href={LOGO_IMAGE} />
    <link rel="sitemap" href={`${SITE_URL}/sitemap-index.xml`} />
    {verificationMetas.map((meta) => <meta name={meta.name} content={meta.content} />)}
    <slot name="head" />
    <script is:inline>
      // 主题防闪烁：首帧前根据持久化偏好或系统偏好设置 data-theme；并标记 JS 可用
      ;(function () {
        document.documentElement.classList.add('js')
        try {
          var stored = localStorage.getItem('portal-theme')
          var theme = stored === 'dark' || stored === 'light' ? stored : null
          if (!theme) {
            theme =
              window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
          }
          document.documentElement.setAttribute('data-theme', theme)
          var meta = document.querySelector('meta[name="theme-color"]')
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0b1020' : '#eef3f8')
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light')
        }
      })()
    </script>
  </head>
  <body>
    <!-- 渐变光斑背景层 -->
    <div class="aurora" aria-hidden="true">
      <span class="blob"></span>
      <span class="blob blob--cyan"></span>
    </div>

    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- 返回顶部 -->
    <button class="back-to-top" type="button" aria-label="返回顶部" data-back-to-top>↑</button>
    <!-- 移动端悬浮 CTA -->
    <div class="sticky-cta" data-sticky-cta>
      <a class="btn btn-primary btn-sm" href="#open">扫码打开小程序</a>
      <a class="btn btn-ghost btn-sm" href="/features/">全部功能</a>
    </div>

    <script>
      // 返回顶部 + 悬浮 CTA 显隐（入场动画由纯 CSS 处理，无 JS 依赖，内容始终可见）
      const backTop = document.querySelector('[data-back-to-top]')
      const sticky = document.querySelector('[data-sticky-cta]')
      let ticking = false
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          const y = window.scrollY
          backTop?.classList.toggle('show', y > 600)
          sticky?.classList.toggle('show', y > 700)
          ticking = false
        })
      }
      window.addEventListener('scroll', onScroll, { passive: true })
      backTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }))
    </script>
  </body>
</html>
