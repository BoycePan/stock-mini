# backend-java 配置模板。
# 复制为 .env 并填入真实值（.env 已被 git 忽略，不会提交）。
#   cp .env.example .env
#
# 启动时由 spring-dotenv 读取工作目录的 .env，等价于环境变量；
# 真实环境变量优先级高于 .env（生产环境建议直接用环境变量注入）。
# 键名对齐 Go 版 backend/config.yaml（database/jwt/wechat/stock.sina/eastmoney/cninfo/ths）。

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gu_yu_stock
DB_USER=root
DB_PASSWORD=your_db_password

# 微信小程序
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# JWT（必须 >= 32 字节，Java 侧 jjwt 要求），可直接复用 Go 版 backend/config.yaml 中的 secret
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long
JWT_EXPIRE_HOURS=24

# 股票数据源（可选，未设置时用 application.yml 默认值兜底）
# SINA_RATE_LIMIT: 两次请求最小间隔（秒）
# SINA_MAX_RETRIES: 失败重试次数（不含首次）
# SINA_TIMEOUT: 超时秒数
SINA_RATE_LIMIT=1
SINA_MAX_RETRIES=3
SINA_TIMEOUT=30

# 东方财富（对齐 Go config.yaml stock.eastmoney，限流最保守）
EASTMONEY_RATE_LIMIT=4
EASTMONEY_MAX_RETRIES=5
EASTMONEY_TIMEOUT=30

# 巨潮资讯（对齐 Go config.yaml stock.cninfo，单线程串行调用不限流）
CNINFO_RATE_LIMIT=0
CNINFO_MAX_RETRIES=1
CNINFO_TIMEOUT=30

# 同花顺（对齐 Go config.yaml stock.ths，默认关闭）
THS_RATE_LIMIT=0.5
THS_MAX_RETRIES=3
THS_TIMEOUT=30

# 雅虎 Python sidecar（方案 A，可选）
# 开发模式默认自动拉起 scripts/fetch_service.py；生产建议 FETCH_ENABLED=false 单独部署。
# FETCH_HTTPS_PROXY/FETCH_HTTP_PROXY：本机开发填 Clash 地址（如 http://127.0.0.1:7890）；
#   生产海外服务器留空=让 yfinance 直连雅虎。
FETCH_ENABLED=true
FETCH_PORT=8001
FETCH_HTTPS_PROXY=http://127.0.0.1:7890
FETCH_HTTP_PROXY=http://127.0.0.1:7890
