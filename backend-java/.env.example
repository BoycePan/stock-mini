# backend-java 配置模板。
# 复制为 .env 并填入真实值（.env 已被 git 忽略，不会提交）。
#   cp .env.example .env
#
# 启动时由 spring-dotenv 读取工作目录的 .env，等价于环境变量；
# 真实环境变量优先级高于 .env（生产环境建议直接用环境变量注入）。
# 键名对齐 Go 版 backend/config.yaml（database/jwt/wechat/stock.sina/eastmoney/cninfo/ths）。

# 数据库
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gu_yu_stock
DB_USER=root
DB_PASSWORD=your_db_password

# 微信小程序（来源 source → appid/secret，见 application.yml 的 app.wechat.apps）
# 现有小程序（source=shiChang-tracker，默认）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret
# 行情追踪小程序（source=hangQing-tracker，app-id 已内置在 application.yml，仅需配置 secret）
HANGQING_TRACKER_WECHAT_APP_SECRET=your_hangqing_tracker_wechat_app_secret

# JWT（必须 >= 32 字节，Java 侧 jjwt 要求），可直接复用 Go 版 backend/config.yaml 中的 secret
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long
JWT_EXPIRE_HOURS=24

# 管理端接口 /api/mgr/** 拦截鉴权（MgrAuthInterceptor，见 application.yml 的 app.mgr 段）
# MGR_AUTH_ENABLED=false 可关闭拦截（调试用，默认 true）
# 管理员登录口令见 application.yml 的 app.mgr.admin-token（用户名@密码 的 base64）
MGR_AUTH_ENABLED=true

# 股票数据源（可选，未设置时用 application.yml 默认值兜底）
# SINA_RATE_LIMIT: 两次请求最小间隔（秒）
# SINA_MAX_RETRIES: 失败重试次数（不含首次）
# SINA_TIMEOUT: 超时秒数
SINA_RATE_LIMIT=1
SINA_MAX_RETRIES=3
SINA_TIMEOUT=30

# 东方财富（对齐 Go config.yaml stock.eastmoney，限流最保守）
EASTMONEY_RATE_LIMIT=4
EASTMONEY_MAX_RETRIES=5
EASTMONEY_TIMEOUT=30

# 巨潮资讯（对齐 Go config.yaml stock.cninfo，单线程串行调用不限流）
CNINFO_RATE_LIMIT=0
CNINFO_MAX_RETRIES=1
CNINFO_TIMEOUT=30

# 同花顺（对齐 Go config.yaml stock.ths，默认关闭）
THS_RATE_LIMIT=0.5
THS_MAX_RETRIES=3
THS_TIMEOUT=30

# 雅虎 Python sidecar（方案 A，可选）
# 镜像内已内置 scripts/fetch_service.py + /opt/venv 依赖，Java 启动时自动拉起、
# Java 退出时随之销毁（同生命周期）。无需单独部署。
# 数据通道二选一：
#   A. Cloudflare Worker 反向代理（推荐，国内/海外服务器都无需 Clash）：
#      FETCH_WORKER_BASE=https://proxy.lilaiyun.online
#      FETCH_AUTH_TOKEN=<Worker 鉴权 token>
#   B. 本机 Clash 代理（FETCH_HTTPS_PROXY/FETCH_HTTP_PROXY 填 Clash 地址）；生产海外留空=直连。
FETCH_ENABLED=true
FETCH_PORT=8001
# 通道 A（选一）：走 Worker 时这两行填 Worker 地址 + token，上面 HTTPS_PROXY 可留空
FETCH_WORKER_BASE=
FETCH_AUTH_TOKEN=
# 通道 B（选一）：本机 Clash
FETCH_HTTPS_PROXY=http://127.0.0.1:7890
FETCH_HTTP_PROXY=http://127.0.0.1:7890

# ── OpenTelemetry → SigNoz 监控（可选）──
# agent jar 由部署脚本从宿主挂载并以 -javaagent 加载（见 README「监控接入」），以下环境变量控制上报。
# 采集是异步的：SigNoz 不可达时业务不受影响（数据丢弃，不阻塞、不重试堆积）。
#
# OTEL_SERVICE_NAME 必填：SigNoz UI 里以此作为服务名
OTEL_SERVICE_NAME=stock-backend
#
# OTLP endpoint：指向 SigNoz ingester。
#   - 本机/开发：http://localhost:18117（gRPC）或 http://localhost:18118（HTTP）
#   - 线上经 Tailscale 回连本机：用本机 Tailscale IP（示例 100.90.180.33），勿用 localhost
#   - SigNoz 上云后：改为线上服务器内网/Tailscale IP
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18117
# 协议：默认 http/protobuf；走 gRPC 端口(18117)时需显式指定 grpc
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
#
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# 附加资源属性（可选）：环境标识等，SigNoz UI 过滤用
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production
#
# 采样率（可选）：0~1，默认 1.0（全量）。流量大时可调低
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
