<view class="page theme-{{ theme }}">
  <view class="page-header">
    <app-header
      title="{{ name || '行情' }}"
      showShare="{{ true }}"
      posterShare="{{ true }}"
      bind:share="onSharePoster"
      showBack="{{ true }}"
      showBrand="{{ false }}"
    ></app-header>
  </view>
  <view class="content-scroll">
    <loading-state
      wx:if="{{ loading }}"
      text="正在加载行情"
      desc="正在为您同步该标的的行情走势，请稍候…"
    ></loading-state>

    <!-- 页面级空态：既无分时源也无 K 线源（KOSDAQ / TOPIX / VIX 等刻意不配置的标的） -->
    <view wx:elif="{{ fatal }}" class="no-data-card">
      <view class="no-data-icon"><text>◌</text></view>
      <text class="no-data-title">暂无行情数据</text>
      <text class="no-data-desc">{{ fatalDesc }}</text>
    </view>

    <block wx:else>
      <view class="data-notice">
        <view class="notice-icon">!</view>
        <text class="notice-text"
          >行情数据来自第三方公开数据，可能存在延迟或误差，请以官方渠道为准，自行核实判断。页面内容仅供参考，不构成任何投资建议，据此操作风险自担。</text
        >
      </view>

      <!-- 基本信息卡片 -->
      <view class="quote-card" wx:if="{{ quote }}">
        <view class="quote-head">
          <view class="quote-title">
            <text class="stock-name">{{ name }}</text>
            <text class="stock-code">{{ code }}</text>
          </view>
          <view class="quote-price">
            <text class="price {{ quote.changeClass }}">{{ quote.price }}</text>
            <text class="quote-change {{ quote.changeClass }}">{{ quote.changeText }}</text>
          </view>
        </view>
        <view class="quote-grid">
          <view>
            <text>今开</text>
            <text>{{ quote.open }}</text>
          </view>
          <view>
            <text>最高</text>
            <text>{{ quote.high }}</text>
          </view>
          <view>
            <text>最低</text>
            <text>{{ quote.low }}</text>
          </view>
          <view>
            <text>均价</text>
            <text>{{ quote.avg }}</text>
          </view>
          <view wx:if="{{ quote.hasVolume }}">
            <text>成交量</text>
            <text>{{ quote.volumeText }}</text>
          </view>
          <view>
            <text>{{ quote.preCloseLabel }}</text>
            <text>{{ quote.preClose }}</text>
          </view>
        </view>
      </view>

      <view class="panel">
        <!-- 周期 TAB：分时 / 日K / 周K / 月K / 年K（无数据源的周期置灰并提示） -->
        <view class="tab-bar">
          <view
            wx:for="{{ tabs }}"
            wx:key="key"
            class="tab {{ item.enabled ? '' : 'tab-disabled' }} {{ mode === item.key ? 'tab-active' : '' }}"
            data-key="{{ item.key }}"
            bindtap="onTabTap"
            >{{ item.label }}</view
          >
        </view>

        <view class="panel-title-row">
          <text class="panel-title">{{ panelTitle }}</text>
          <text class="panel-source" wx:if="{{ sourceLabel }}">{{ sourceLabel }}</text>
        </view>
        <view wx:if="{{ chartNote }}" class="minute-note">{{ chartNote }}</view>

        <view class="chart-wrap {{ klineMode ? 'is-kline' : '' }}">
          <quote-chart
            wx:if="{{ chartReady }}"
            mode="{{ mode }}"
            points="{{ chartPoints }}"
            preClose="{{ chartPreClose }}"
            session="{{ session }}"
            klines="{{ chartKlines }}"
            theme="{{ theme }}"
          ></quote-chart>
          <view wx:elif="{{ chartLoading }}" class="chart-state">
            <view class="chart-spinner"></view>
            <text class="chart-state-text">正在加载{{ panelTitle }}</text>
          </view>
          <view wx:else class="chart-state">
            <text class="chart-state-text">{{ chartError }}</text>
            <button wx:if="{{ chartRetryable }}" class="chart-retry" bindtap="onRetry"
              >重新加载</button
            >
          </view>
        </view>
      </view>

      <!-- 广告位：行情页放在图表下方（location=minute-detail） -->
      <ad-banner location="minute-detail" placement="top"></ad-banner>
    </block>

    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </view>

  <!-- 分享海报（隐藏画布 + 预览弹窗；分时按 minutePoster 绘制，K 线按 posterKlines 绘制） -->
  <share-poster
    id="sharePoster"
    posterData="{{ posterData }}"
    klines="{{ posterKlines }}"
    chartTitle="{{ panelTitle }}"
    minuteChart="{{ minutePoster }}"
    entrancePath="{{ shareEntrancePath }}"
  ></share-poster>
</view>
