/* 与 stock-detail 同风格：页面级滚动（2d canvas 在 scroll-view 内模拟器不跟随滚动） */
.page {
  display: block;
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(238, 243, 249, 0.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.page.theme-dark .page-header {
  background: rgba(17, 24, 39, 0.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.content-scroll {
  padding: 0 24rpx;
}

/* 数据延迟免责提示 */
.data-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f3e6c8;
  border-radius: 20rpx;
  background: #fffaf0;
}

.notice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #e8b04c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
  color: #8a6d3b;
  font-size: 23rpx;
  line-height: 36rpx;
}

.page.theme-dark .data-notice {
  border-color: #4a4430;
  background: #26241a;
}

.page.theme-dark .notice-icon {
  background: #d9a54a;
  color: #1d1c14;
}

.page.theme-dark .notice-text {
  color: #d9c9a3;
}

.quote-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fff 0%, #f8fbff 100%);
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 32rpx rgba(30, 60, 110, 0.14);
}

.panel {
  margin-top: 18rpx;
  padding: 28rpx 0;
  border: 1rpx solid #d4dfec;
  border-radius: 28rpx;
  background: #fff;
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 32rpx rgba(30, 60, 110, 0.14);
}

.panel-head {
  padding: 0 24rpx;
}

.quote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.quote-title {
  min-width: 0;
}

.stock-name {
  display: block;
  color: #152338;
  font-size: 35rpx;
  font-weight: 700;
}

.stock-code {
  display: block;
  margin-top: 8rpx;
  color: #8a98aa;
  font-size: 23rpx;
}

.quote-price {
  flex-shrink: 0;
  text-align: right;
}

.price {
  display: block;
  font-size: 47rpx;
  font-weight: 750;
  line-height: 56rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.quote-change {
  display: block;
  margin-top: 4rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.up {
  color: #eb514d;
}

.down {
  color: #20a66a;
}

.flat {
  color: #34445a;
}

.quote-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 10rpx;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e2eaf3;
}

.quote-grid view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.quote-grid text:first-child {
  color: #8a98aa;
  font-size: 22rpx;
}

.quote-grid text:last-child {
  color: #34445a;
  font-size: 26rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

/* ---------------------------------------------------------------------------
   周期 TAB（分时 / 日K / 周K / 月K / 年K）：胶囊分段控件
   --------------------------------------------------------------------------- */
.tab-bar {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f2f6fa;
}

.tab {
  flex: 1;
  border-radius: 13rpx;
  color: #718096;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
}

.tab-active {
  background: #ffffff;
  color: #4278ed;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(30, 60, 110, 0.12);
}

/* 无该周期数据源：置灰不可点（点击给出 toast 提示），仍保留位置避免 TAB 跳动 */
.tab-disabled {
  color: #b6c2d2;
  font-weight: 500;
}

.panel-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
}

.panel-title {
  color: #152338;
  font-size: 30rpx;
  font-weight: 700;
}

.panel-source {
  flex-shrink: 0;
  color: #99a6b7;
  font-size: 20rpx;
}

.minute-note {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e6eef7;
  border-radius: 16rpx;
  background: #f5f8fc;
  color: #718096;
  font-size: 22rpx;
  line-height: 34rpx;
}

.page.theme-dark .minute-note {
  border-color: #2a394e;
  background: #223248;
  color: #9cacc0;
}

/* 图表容器：高度与图表画布一致（按周期区分），保证加载 / 空态不引起布局跳动。
   注意必须是「纵向 flex + 交叉轴 stretch（默认）」：行向 flex 的交叉轴是纵向，
   <quote-chart> 宿主节点会按内容（max-content）收缩宽度，画布 width:100% 失去可解析的
   包含块宽度、最终塌成 0 宽 → 画布有高度但整块空白（历史缺陷：分时图不出图）。
   纵向主轴 + justifyContent:center 保留加载 / 空态的水平居中与垂直居中。
   canvas 区域左右无外边距，直接撑满 panel 宽度。 */
.chart-wrap {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-top: 16rpx;
  min-height: 620rpx;
}

.chart-wrap.is-kline {
  min-height: 940rpx;
}

.chart-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 0 24rpx;
}

.chart-state-text {
  color: #99a6b7;
  font-size: 24rpx;
  line-height: 38rpx;
  text-align: center;
}

/* 加载动效：三点脉冲（纯 CSS，避免额外资源） */
.chart-spinner {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #4278ed;
  box-shadow:
    24rpx 0 0 #4278ed,
    -24rpx 0 0 #4278ed;
  animation: chart-pulse 0.9s ease-in-out infinite;
}

@keyframes chart-pulse {
  0%,
  100% {
    opacity: 0.35;
  }
  50% {
    opacity: 1;
  }
}

.chart-retry {
  margin: 0;
  padding: 0 56rpx;
  border-radius: 40rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 26rpx;
  line-height: 72rpx;
}

/* 暂无数据引导卡（既无分时源也无 K 线源） */
.no-data-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18rpx;
  padding: 96rpx 48rpx 72rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 28rpx;
  background: #fff;
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 32rpx rgba(30, 60, 110, 0.14);
}

.no-data-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #edf4ff 0%, #dbe9ff 100%);
}

.no-data-icon text {
  color: #4278ed;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
}

.no-data-title {
  margin-top: 28rpx;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

.no-data-desc {
  margin-top: 14rpx;
  padding: 0 20rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
}

.bottom-space {
  height: 40rpx;
}

/* ---------------------------------------------------------------------------
   深色主题
   --------------------------------------------------------------------------- */
.page.theme-dark .panel {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

.page.theme-dark .quote-card {
  border-color: #2a394e;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.25);
}

.page.theme-dark .panel-title {
  color: #f5f7fb;
}

.page.theme-dark .tab-bar {
  background: #223248;
}

.page.theme-dark .tab {
  color: #9cacc0;
}

.page.theme-dark .tab-active {
  background: #2c3f5c;
  color: #6fa3ff;
  box-shadow: none;
}

.page.theme-dark .tab-disabled {
  color: #5c6b80;
}

.page.theme-dark .panel-source {
  color: #7c8ba0;
}

.page.theme-dark .chart-state-text {
  color: #9cacc0;
}

.page.theme-dark .chart-spinner {
  background: #6fa3ff;
  box-shadow:
    24rpx 0 0 #6fa3ff,
    -24rpx 0 0 #6fa3ff;
}

.page.theme-dark .chart-retry {
  background: #233046;
  color: #6fa3ff;
}

.page.theme-dark .no-data-card {
  border-color: #2a394e;
  background: #1a2637;
}

.page.theme-dark .no-data-icon {
  background: linear-gradient(145deg, #233046 0%, #1b2a44 100%);
}

.page.theme-dark .no-data-icon text {
  color: #6fa3ff;
}

.page.theme-dark .no-data-title {
  color: #f5f7fb;
}

.page.theme-dark .no-data-desc {
  color: #9cacc0;
}

/* 深色主题 · 基本信息卡片（渐变覆盖公共 panel 背景） */
.page.theme-dark .quote-card {
  background: linear-gradient(145deg, #1a2637 0%, #1e2c40 100%);
}

.page.theme-dark .stock-name {
  color: #f5f7fb;
}

.page.theme-dark .stock-code {
  color: #9cacc0;
}

.page.theme-dark .price.flat {
  color: #f5f7fb;
}

.page.theme-dark .quote-grid {
  border-top-color: #2a394e;
}

.page.theme-dark .quote-grid text:first-child {
  color: #9cacc0;
}

.page.theme-dark .quote-grid text:last-child {
  color: #e5ebf4;
}
