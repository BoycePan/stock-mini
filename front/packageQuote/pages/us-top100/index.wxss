/* 与 minute / stock-detail 同风格：页面级滚动 */
.page {
  display: block;
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(238, 243, 249, 0.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.page.theme-dark .page-header {
  background: rgba(17, 24, 39, 0.9);
}

.content-scroll {
  padding: 0 24rpx;
}

/* 数据延迟免责提示 */
.data-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f3e6c8;
  border-radius: 20rpx;
  background: #fffaf0;
}

.notice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #e8b04c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
  color: #8a6d3b;
  font-size: 23rpx;
  line-height: 36rpx;
}

.page.theme-dark .data-notice {
  border-color: #4a4430;
  background: #26241a;
}

.page.theme-dark .notice-icon {
  background: #d9a54a;
  color: #1d1c14;
}

.page.theme-dark .notice-text {
  color: #d9c9a3;
}

/* 更新时间 */
.list-updated {
  margin-top: 18rpx;
  color: #99a6b7;
  font-size: 22rpx;
}

.page.theme-dark .list-updated {
  color: #9cacc0;
}

/* 表头行 */
.list-head {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  padding: 0 20rpx 14rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .list-head {
  border-bottom-color: #2a394e;
}

.list-head text {
  color: #99a6b7;
  font-size: 22rpx;
}

/* 列宽（与 .stock-row 各列一致） */
.hd-rank {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
}

.hd-name {
  flex: 1;
  min-width: 0;
}

.hd-price {
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
}

.hd-pct {
  width: 118rpx;
  flex-shrink: 0;
  text-align: right;
}

.hd-cap {
  width: 168rpx;
  flex-shrink: 0;
  text-align: right;
}

/* 个股行 */
.stock-row {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.stock-row:last-child {
  border-bottom: none;
}

.row-hover {
  background: rgba(66, 120, 237, 0.06);
}

.rank-no {
  color: #99a6b7;
  font-size: 24rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

/* 前三名排名号高亮 */
.stock-row:nth-child(-n + 3) .rank-no {
  color: #4278ed;
  font-weight: 700;
}

.name-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.stock-name {
  color: #152338;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stock-code {
  margin-top: 4rpx;
  color: #8a98aa;
  font-size: 20rpx;
}

.price-text {
  color: #152338;
  font-size: 26rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.pct-text {
  font-size: 24rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.pct-text.up {
  color: #eb514d;
}

.pct-text.down {
  color: #20a66a;
}

.pct-text.flat {
  color: #8a98aa;
}

.cap-text {
  color: #718096;
  font-size: 22rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.bottom-space {
  height: 40rpx;
}

/* 深色主题 */
.page.theme-dark .row-hover {
  background: rgba(111, 163, 255, 0.1);
}

.page.theme-dark .rank-no {
  color: #9cacc0;
}

.page.theme-dark .stock-row:nth-child(-n + 3) .rank-no {
  color: #6fa3ff;
}

.page.theme-dark .stock-name {
  color: #f5f7fb;
}

.page.theme-dark .stock-code {
  color: #9cacc0;
}

.page.theme-dark .price-text {
  color: #f5f7fb;
}

.page.theme-dark .pct-text.flat {
  color: #9cacc0;
}

.page.theme-dark .cap-text {
  color: #9cacc0;
}

.page.theme-dark .list-head text {
  color: #9cacc0;
}

/* 首次加载失败卡：错误提示 + 重试 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18rpx;
  padding: 72rpx 48rpx 64rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 28rpx;
  background: #fff;
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 32rpx rgba(30, 60, 110, 0.14);
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fdf0ef;
}

.error-icon text {
  color: #eb514d;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.error-text {
  margin-top: 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-retry {
  margin-top: 32rpx;
  padding: 0 64rpx;
  border-radius: 40rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 26rpx;
  line-height: 76rpx;
}

.page.theme-dark .error-card {
  border-color: #2a394e;
  background: #1a2637;
}

.page.theme-dark .error-icon {
  background: #3a2426;
}

.page.theme-dark .error-icon text {
  color: #ff8a85;
}

.page.theme-dark .error-text {
  color: #9cacc0;
}

.page.theme-dark .error-retry {
  background: #233046;
  color: #6fa3ff;
}
