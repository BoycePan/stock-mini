/* 与 us-top100 / minute / stock-detail 同风格：flex 纵向布局。
   头部固定在滚动区外，内容区由 scroll-view 滚动 / 下拉刷新，
   不使用页面默认下拉刷新（见 index.json enablePullDownRefresh=false）。
   高度/溢出沿用 app.wxss .page（100vh + overflow hidden）。 */
.page {
  display: flex;
  flex-direction: column;
}

.page-header {
  flex-shrink: 0;
  /* 头部在滚动区外、不随内容滚动：无需 sticky / 半透明遮罩背景 */
}

.page.theme-dark .page-header {
  background: transparent;
}

/* 内容区滚动容器（scroll-view）：占满头部以下剩余高度 */
.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 0;
}

/* 数据延迟免责提示条 */
.data-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3e6c8;
  background: #fffaf0;
}

.notice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #e8b04c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
  color: #8a6d3b;
  font-size: 23rpx;
  line-height: 36rpx;
}

.page.theme-dark .data-notice {
  border-bottom-color: #4a4430;
  background: #26241a;
}

.page.theme-dark .notice-icon {
  background: #d9a54a;
  color: #1d1c14;
}

.page.theme-dark .notice-text {
  color: #d9c9a3;
}

/* 粘性头部内的搜索区（随导航固顶，数据加载完成后才显示） */
.header-search {
  padding: 12rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #d4dfec;
}

.page.theme-dark .header-search {
  border-bottom-color: #2a394e;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 36rpx;
  background: #fff;
  height: 72rpx;
}

.page.theme-dark .search-box {
  border-color: #2a394e;
  background: #1a2637;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #152338;
  font-size: 26rpx;
  line-height: 72rpx;
}

.page.theme-dark .search-input {
  color: #f5f7fb;
}

.search-placeholder {
  color: #99a6b7;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(132, 146, 165, 0.12);
}

.search-clear-hover {
  opacity: 0.6;
}

/* 列表上方信息行 */
.list-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
}

.total-text {
  flex-shrink: 0;
  color: #718096;
  font-size: 22rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.32);
  border-radius: 24rpx;
  background: rgba(66, 120, 237, 0.08);
  color: #4278ed;
  font-size: 22rpx;
  font-weight: 600;
}

.sort-btn-hover {
  opacity: 0.7;
}

.sort-label {
  color: #4278ed;
}

.page.theme-dark .total-text {
  color: #9cacc0;
}

.page.theme-dark .sort-btn {
  border-color: rgba(111, 163, 255, 0.4);
  background: rgba(111, 163, 255, 0.14);
  color: #6fa3ff;
}

.page.theme-dark .sort-label {
  color: #6fa3ff;
}

.list-updated {
  flex-shrink: 0;
  margin-left: auto;
  color: #99a6b7;
  font-size: 22rpx;
}

.page.theme-dark .list-updated {
  color: #9cacc0;
}

/* 表头 */
.list-head {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx 14rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .list-head {
  border-bottom-color: #2a394e;
}

.list-head text {
  color: #99a6b7;
  font-size: 22rpx;
}

.page.theme-dark .list-head text {
  color: #9cacc0;
}

/* 列宽（与 .board-row 各列一致） */
.hd-rank {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
}

.hd-name {
  flex: 1;
  min-width: 0;
}

.hd-pct {
  width: 130rpx;
  flex-shrink: 0;
  text-align: right;
}

/* 行业行 */
.board-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .board-row {
  border-bottom-color: #2a394e;
}

.rank-no {
  color: #99a6b7;
  font-size: 24rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

/* 前三名排名号高亮（领涨/领跌榜首） */
.board-row:nth-child(-n + 3) .rank-no {
  color: #4278ed;
  font-weight: 700;
}

.page.theme-dark .rank-no {
  color: #9cacc0;
}

.page.theme-dark .board-row:nth-child(-n + 3) .rank-no {
  color: #6fa3ff;
}

.name-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.board-name {
  color: #152338;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.board-code {
  margin-top: 4rpx;
  color: #8a98aa;
  font-size: 20rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.page.theme-dark .board-name {
  color: #f5f7fb;
}

.page.theme-dark .board-code {
  color: #9cacc0;
}

.pct-text {
  font-size: 26rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.pct-text.up {
  color: #eb514d;
}

.pct-text.down {
  color: #20a66a;
}

.pct-text.flat {
  color: #8a98aa;
}

.page.theme-dark .pct-text.flat {
  color: #9cacc0;
}

/* 无匹配结果 */
.empty-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 96rpx 24rpx;
  color: #99a6b7;
  font-size: 25rpx;
}

.page.theme-dark .empty-row {
  color: #9cacc0;
}

.bottom-space {
  height: 40rpx;
}

/* 首次加载失败卡 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18rpx;
  padding: 72rpx 48rpx 64rpx;
  border-bottom: 1rpx solid #d4dfec;
  background: #fff;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fdf0ef;
}

.error-icon text {
  color: #eb514d;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.error-text {
  margin-top: 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-retry {
  margin-top: 32rpx;
  padding: 0 64rpx;
  border-radius: 40rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 26rpx;
  line-height: 76rpx;
}

.page.theme-dark .error-card {
  border-bottom-color: #2a394e;
  background: #1a2637;
}

.page.theme-dark .error-icon {
  background: #3a2426;
}

.page.theme-dark .error-icon text {
  color: #ff8a85;
}

.page.theme-dark .error-text {
  color: #9cacc0;
}

.page.theme-dark .error-retry {
  background: #233046;
  color: #6fa3ff;
}

/* 概念板块 / 行业板块 切换 tab（常驻粘性头部，加载中也可切换） */
.board-tabs {
  display: flex;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #d4dfec;
}

.page.theme-dark .board-tabs {
  border-bottom-color: #2a394e;
}

.board-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  color: #718096;
  font-size: 28rpx;
  font-weight: 500;
}

.board-tab-text {
  line-height: 1;
}

/* 当前 tab：主题色文字 + 底部短指示条 */
.board-tab-active {
  color: #4278ed;
  font-weight: 700;
}

.board-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #4278ed;
}

.board-tab-hover {
  opacity: 0.7;
}

.page.theme-dark .board-tab {
  color: #9cacc0;
}

.page.theme-dark .board-tab-active {
  color: #6fa3ff;
}

.page.theme-dark .board-tab-active::after {
  background: #6fa3ff;
}

/* 板块行可点击反馈 */
.board-row-hover {
  background: #f2f6fa;
}

.page.theme-dark .board-row-hover {
  background: #223248;
}

/* ---------------------------------------------------------------------------
 * 板块成分股弹窗（点板块行打开，底部上弹面板）
 * --------------------------------------------------------------------------- */
.member-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 300;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 16, 26, 0.55);
  /* 入场淡入，避免 wx:if 挂载时的生硬闪现 */
  animation: member-mask-in 0.16s ease-out;
}

/* 弹窗整体淡入 + 自底部上滑（入场动画在挂载时播放一次） */
@keyframes member-mask-in {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

.member-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 78vh;
  overflow: hidden;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  padding-bottom: env(safe-area-inset-bottom);
  animation: member-sheet-in 0.3s cubic-bezier(0.2, 0.8, 0.24, 1);
}

@keyframes member-sheet-in {
  from {
    opacity: 0;
    transform: translateY(12vh);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page.theme-dark .member-sheet {
  background: #1a2637;
}

/* 弹窗头部：板块名 + 所属分类 / 只数 + 关闭 */
.member-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx 22rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .member-head {
  border-bottom-color: #2a394e;
}

.member-head-text {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.member-title {
  color: #152338;
  font-size: 34rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-sub {
  margin-top: 6rpx;
  color: #718096;
  font-size: 22rpx;
}

.page.theme-dark .member-title {
  color: #f5f7fb;
}

.page.theme-dark .member-sub {
  color: #9cacc0;
}

.member-close {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(132, 146, 165, 0.12);
}

.member-close-hover {
  opacity: 0.6;
}

/* 弹窗中间状态：加载 / 失败 / 空 */
.member-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 48rpx 48rpx 96rpx;
}

.member-state-text {
  color: #718096;
  font-size: 26rpx;
  text-align: center;
  line-height: 40rpx;
}

.page.theme-dark .member-state-text {
  color: #9cacc0;
}

.member-retry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 0 44rpx;
  height: 68rpx;
  border-radius: 36rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 25rpx;
  font-weight: 600;
}

.member-retry-hover {
  opacity: 0.7;
}

.page.theme-dark .member-retry {
  background: #233046;
  color: #6fa3ff;
}

/* 弹窗内信息行：排序 + 更新时间（复用 .sort-btn / .list-updated 视觉） */
.member-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 28rpx 14rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .member-meta {
  border-bottom-color: #2a394e;
}

/* 成分股滚动列表：占弹窗剩余高度 */
.member-scroll {
  flex: 1;
  min-height: 0;
  max-height: 60vh;
}

.member-row {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .member-row {
  border-bottom-color: #2a394e;
}

.member-row-hover {
  background: #f2f6fa;
}

.page.theme-dark .member-row-hover {
  background: #223248;
}

.member-rank {
  flex-shrink: 0;
  width: 48rpx;
  color: #99a6b7;
  font-size: 24rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
  text-align: center;
}

/* 前三名排名号高亮（领涨/领跌榜首） */
.member-row:nth-child(-n + 3) .member-rank {
  color: #4278ed;
  font-weight: 700;
}

.page.theme-dark .member-rank {
  color: #9cacc0;
}

.page.theme-dark .member-row:nth-child(-n + 3) .member-rank {
  color: #6fa3ff;
}

.member-name-col {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-right: 16rpx;
}

.member-name {
  color: #152338;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.member-code {
  margin-top: 4rpx;
  color: #8a98aa;
  font-size: 20rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.page.theme-dark .member-name {
  color: #f5f7fb;
}

.page.theme-dark .member-code {
  color: #9cacc0;
}

.member-pct {
  flex-shrink: 0;
  width: 130rpx;
  text-align: right;
}