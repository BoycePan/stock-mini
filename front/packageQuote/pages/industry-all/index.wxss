/* 与 us-top100 / minute / stock-detail 同风格：页面级滚动 + 粘性头部 */
.page {
  display: block;
  min-height: 100vh;
  overflow: visible;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(238, 243, 249, 0.9);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
}

.page.theme-dark .page-header {
  background: rgba(17, 24, 39, 0.9);
}

/* 无左右留白：列表全宽展示（内边距由各区块自行控制） */
.content-scroll {
  padding: 0;
}

/* 数据延迟免责提示条 */
.data-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f3e6c8;
  background: #fffaf0;
}

.notice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #e8b04c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
  color: #8a6d3b;
  font-size: 23rpx;
  line-height: 36rpx;
}

.page.theme-dark .data-notice {
  border-bottom-color: #4a4430;
  background: #26241a;
}

.page.theme-dark .notice-icon {
  background: #d9a54a;
  color: #1d1c14;
}

.page.theme-dark .notice-text {
  color: #d9c9a3;
}

/* 粘性头部内的搜索区（随导航固顶，数据加载完成后才显示） */
.header-search {
  padding: 12rpx 24rpx 16rpx;
  border-bottom: 1rpx solid #d4dfec;
}

.page.theme-dark .header-search {
  border-bottom-color: #2a394e;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 36rpx;
  background: #fff;
  height: 72rpx;
}

.page.theme-dark .search-box {
  border-color: #2a394e;
  background: #1a2637;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #152338;
  font-size: 26rpx;
  line-height: 72rpx;
}

.page.theme-dark .search-input {
  color: #f5f7fb;
}

.search-placeholder {
  color: #99a6b7;
}

.search-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(132, 146, 165, 0.12);
}

.search-clear-hover {
  opacity: 0.6;
}

/* 列表上方信息行 */
.list-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 0 24rpx;
}

.total-text {
  flex-shrink: 0;
  color: #718096;
  font-size: 22rpx;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.32);
  border-radius: 24rpx;
  background: rgba(66, 120, 237, 0.08);
  color: #4278ed;
  font-size: 22rpx;
  font-weight: 600;
}

.sort-btn-hover {
  opacity: 0.7;
}

.sort-label {
  color: #4278ed;
}

.page.theme-dark .total-text {
  color: #9cacc0;
}

.page.theme-dark .sort-btn {
  border-color: rgba(111, 163, 255, 0.4);
  background: rgba(111, 163, 255, 0.14);
  color: #6fa3ff;
}

.page.theme-dark .sort-label {
  color: #6fa3ff;
}

.list-updated {
  flex-shrink: 0;
  margin-left: auto;
  color: #99a6b7;
  font-size: 22rpx;
}

.page.theme-dark .list-updated {
  color: #9cacc0;
}

/* 表头 */
.list-head {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 0 24rpx 14rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .list-head {
  border-bottom-color: #2a394e;
}

.list-head text {
  color: #99a6b7;
  font-size: 22rpx;
}

.page.theme-dark .list-head text {
  color: #9cacc0;
}

/* 列宽（与 .board-row 各列一致） */
.hd-rank {
  width: 64rpx;
  flex-shrink: 0;
  text-align: center;
}

.hd-name {
  flex: 1;
  min-width: 0;
}

.hd-pct {
  width: 130rpx;
  flex-shrink: 0;
  text-align: right;
}

/* 行业行 */
.board-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e2eaf3;
}

.page.theme-dark .board-row {
  border-bottom-color: #2a394e;
}

.rank-no {
  color: #99a6b7;
  font-size: 24rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

/* 前三名排名号高亮（领涨/领跌榜首） */
.board-row:nth-child(-n + 3) .rank-no {
  color: #4278ed;
  font-weight: 700;
}

.page.theme-dark .rank-no {
  color: #9cacc0;
}

.page.theme-dark .board-row:nth-child(-n + 3) .rank-no {
  color: #6fa3ff;
}

.name-col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.board-name {
  color: #152338;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.board-code {
  margin-top: 4rpx;
  color: #8a98aa;
  font-size: 20rpx;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.page.theme-dark .board-name {
  color: #f5f7fb;
}

.page.theme-dark .board-code {
  color: #9cacc0;
}

.pct-text {
  font-size: 26rpx;
  font-weight: 600;
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
}

.pct-text.up {
  color: #eb514d;
}

.pct-text.down {
  color: #20a66a;
}

.pct-text.flat {
  color: #8a98aa;
}

.page.theme-dark .pct-text.flat {
  color: #9cacc0;
}

/* 无匹配结果 */
.empty-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 96rpx 24rpx;
  color: #99a6b7;
  font-size: 25rpx;
}

.page.theme-dark .empty-row {
  color: #9cacc0;
}

.bottom-space {
  height: 40rpx;
}

/* 首次加载失败卡 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 18rpx;
  padding: 72rpx 48rpx 64rpx;
  border-bottom: 1rpx solid #d4dfec;
  background: #fff;
}

.error-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fdf0ef;
}

.error-icon text {
  color: #eb514d;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.error-text {
  margin-top: 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-retry {
  margin-top: 32rpx;
  padding: 0 64rpx;
  border-radius: 40rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 26rpx;
  line-height: 76rpx;
}

.page.theme-dark .error-card {
  border-bottom-color: #2a394e;
  background: #1a2637;
}

.page.theme-dark .error-icon {
  background: #3a2426;
}

.page.theme-dark .error-icon text {
  color: #ff8a85;
}

.page.theme-dark .error-text {
  color: #9cacc0;
}

.page.theme-dark .error-retry {
  background: #233046;
  color: #6fa3ff;
}
