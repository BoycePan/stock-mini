<view class="page theme-{{ theme }}">
  <!-- 头部固定在滚动区外（不随内容滚动）：导航 + 概念/行业 tab + 搜索框（加载完成前不显示搜索） -->
  <view class="page-header">
    <app-header
      title="{{ headerTitle }}"
      showShare="{{ false }}"
      showBack="{{ true }}"
      showBrand="{{ false }}"
    ></app-header>

    <!-- 概念板块 / 行业板块 切换 tab（常驻：加载中 / 失败也可切到另一类） -->
    <view class="board-tabs">
      <view
        wx:for="{{ tabs }}"
        wx:key="key"
        class="board-tab {{ activeTab === item.key ? 'board-tab-active' : '' }}"
        data-kind="{{ item.key }}"
        hover-class="board-tab-hover"
        bindtap="onTabTap"
        aria-role="button"
        aria-label="切换到{{ item.label }}"
      >
        <text class="board-tab-text">{{ item.label }}</text>
      </view>
    </view>

    <view wx:if="{{ !loading && !error }}" class="header-search">
      <view class="search-box">
        <t-icon name="search" size="28rpx" color="{{ theme === 'dark' ? '#9cacc0' : '#99a6b7' }}" />
        <input
          class="search-input"
          placeholder="{{ searchPlaceholder }}"
          placeholder-class="search-placeholder"
          value="{{ query }}"
          confirm-type="search"
          bindinput="onSearchInput"
        />
        <view
          wx:if="{{ query }}"
          class="search-clear"
          hover-class="search-clear-hover"
          bindtap="onSearchClear"
          aria-role="button"
          aria-label="清空搜索"
        >
          <t-icon
            name="close"
            size="24rpx"
            color="{{ theme === 'dark' ? '#9cacc0' : '#99a6b7' }}"
          />
        </view>
      </view>
    </view>
  </view>
  <!-- 内容区滚动容器：列表滚动 / 下拉刷新都在 scroll-view 内，不使用页面默认下拉刷新 -->
  <scroll-view
    class="content-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{ false }}"
    refresher-enabled
    refresher-triggered="{{ refreshing }}"
    refresher-default-style="{{ theme === 'dark' ? 'white' : 'black' }}"
    refresher-background="{{ theme === 'dark' ? '#151e2d' : '#e4ecf5' }}"
    bindrefresherrefresh="onRefresherRefresh"
  >
    <loading-state
      wx:if="{{ loading }}"
      text="{{ loadingText }}"
      desc="{{ loadingDesc }}"
    ></loading-state>

    <!-- 首次加载失败 / 空数据：错误提示 + 重试 -->
    <view wx:elif="{{ error }}" class="error-card">
      <view class="error-icon"><text>!</text></view>
      <text class="error-text">{{ error }}</text>
      <button class="error-retry" bindtap="onRetry">重新加载</button>
    </view>

    <block wx:else>
      <view class="data-notice">
        <view class="notice-icon">!</view>
        <text class="notice-text">行情来自公开接口，仅供参考，不构成投资建议。</text>
      </view>

      <!-- 列表上方信息行：当前板块总数 + 排序按钮 + 更新时间 -->
      <view class="list-meta">
        <text class="total-text">共 {{ totalCount }} 个{{ countUnit }}</text>
        <view
          class="sort-btn"
          hover-class="sort-btn-hover"
          bindtap="onSortToggle"
          aria-role="button"
          aria-label="切换涨跌幅排序"
        >
          <text>按涨跌幅</text>
          <t-icon
            name="{{ sortDir === 'desc' ? 'arrow-triangle-down' : 'arrow-triangle-up' }}"
            size="26rpx"
            color="{{ theme === 'dark' ? '#6fa3ff' : '#4278ed' }}"
          />
          <text class="sort-label">{{ sortDir === 'desc' ? '领涨榜' : '领跌榜' }}</text>
        </view>
        <text wx:if="{{ updatedLabel }}" class="list-updated">{{ updatedLabel }}</text>
      </view>

      <!-- 表头 -->
      <view class="list-head">
        <text class="hd-rank">#</text>
        <text class="hd-name">板块名称</text>
        <text class="hd-pct">涨跌幅</text>
      </view>

      <view wx:if="{{ !items.length }}" class="empty-row">
        <text>{{ emptyText }}</text>
      </view>

      <view
        class="board-row"
        hover-class="board-row-hover"
        wx:for="{{ items }}"
        wx:key="code"
        data-index="{{ index }}"
        bindtap="onBoardRowTap"
        aria-role="button"
        aria-label="查看{{ item.name }}成分股"
      >
        <text class="hd-rank rank-no">{{ index + 1 }}</text>
        <view class="hd-name name-col">
          <text class="board-name">{{ item.name }}</text>
          <text class="board-code">{{ item.code }}</text>
        </view>
        <text class="hd-pct pct-text {{ item.pctClass }}">{{ item.pctText }}</text>
      </view>
    </block>

    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 板块成分股弹窗：点板块行打开，成分股按涨跌幅排序 -->
  <view
    wx:if="{{ memberVisible }}"
    class="member-mask"
    catchtouchmove="onMemberMaskTouch"
    bindtap="onMemberClose"
  >
    <view class="member-sheet" catchtap="onMemberMaskTouch">
      <view class="member-head">
        <view class="member-head-text">
          <text class="member-title">{{ memberBoardName }}</text>
          <text
            wx:if="{{ memberKindLabel && !memberLoading && !memberError && !memberEmpty }}"
            class="member-sub"
            >{{ memberKindLabel }} · 共 {{ memberCount }} 只成分股</text
          >
        </view>
        <view
          class="member-close"
          hover-class="member-close-hover"
          bindtap="onMemberClose"
          aria-role="button"
          aria-label="关闭成分股"
        >
          <t-icon
            name="close"
            size="28rpx"
            color="{{ theme === 'dark' ? '#9cacc0' : '#718096' }}"
          />
        </view>
      </view>

      <!-- 弹窗内容：加载 / 失败 / 空 / 列表 -->
      <view wx:if="{{ memberLoading }}" class="member-state">
        <text class="member-state-text">正在加载成分股…</text>
      </view>
      <view wx:elif="{{ memberError }}" class="member-state">
        <text class="member-state-text">{{ memberError }}</text>
        <view
          class="member-retry"
          hover-class="member-retry-hover"
          bindtap="onMemberRetry"
          aria-role="button"
          aria-label="重新加载成分股"
        >
          <text>重新加载</text>
        </view>
      </view>
      <view wx:elif="{{ memberEmpty }}" class="member-state">
        <text class="member-state-text">该板块暂无成分股数据</text>
      </view>
      <block wx:else>
        <view class="member-meta">
          <view
            class="sort-btn member-sort"
            hover-class="sort-btn-hover"
            bindtap="onMemberSortToggle"
            aria-role="button"
            aria-label="切换成分股涨跌幅排序"
          >
            <text>按涨跌幅</text>
            <t-icon
              name="{{ memberSortDir === 'desc' ? 'arrow-triangle-down' : 'arrow-triangle-up' }}"
              size="26rpx"
              color="{{ theme === 'dark' ? '#6fa3ff' : '#4278ed' }}"
            />
            <text class="sort-label">{{ memberSortDir === 'desc' ? '领涨榜' : '领跌榜' }}</text>
          </view>
          <text wx:if="{{ memberUpdatedLabel }}" class="list-updated">{{
            memberUpdatedLabel
          }}</text>
        </view>

        <scroll-view class="member-scroll" scroll-y enhanced show-scrollbar="{{ false }}">
          <view
            class="member-row"
            hover-class="member-row-hover"
            wx:for="{{ memberItems }}"
            wx:key="code"
            data-index="{{ index }}"
            bindtap="onMemberRowTap"
            aria-role="button"
            aria-label="查看{{ item.name }}当日分时"
          >
            <text class="member-rank">{{ index + 1 }}</text>
            <view class="member-name-col">
              <text class="member-name">{{ item.name }}</text>
              <text class="member-code">{{ item.code }}</text>
            </view>
            <text class="member-pct pct-text {{ item.pctClass }}">{{ item.pctText }}</text>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
