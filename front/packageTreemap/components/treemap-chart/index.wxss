.treemap-chart {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
}

.treemap-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

/* 缩放指示（右下角悬浮 pill） */
.zoom-pill {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #152338;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(21, 35, 56, 0.14);
}

.zoom-pill-hover {
  opacity: 0.7;
}

/* 深色主题 */
.treemap-chart.theme-dark .zoom-pill {
  color: #f5f7fb;
  background: rgba(26, 38, 55, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}
