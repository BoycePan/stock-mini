<view class="loading-state {{theme === 'dark' ? 'dark' : ''}}">
  <view class="loading-spinner"></view>
  <view class="loading-copy">
    <text class="loading-text">{{text}}</text>
    <text wx:if="{{desc}}" class="loading-desc">{{desc}}</text>
  </view>
  <!-- 骨架预览行：模拟即将出现的卡片内容 -->
  <view class="loading-skeleton-rows">
    <view class="loading-skeleton-row wide"></view>
    <view class="loading-skeleton-row medium"></view>
    <view class="loading-skeleton-row narrow"></view>
  </view>
</view>
