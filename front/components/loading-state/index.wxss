.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  color: #728197;
  font-size: 26rpx;
}

.loading-dot {
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
  border: 4rpx solid #dce6f2;
  border-top-color: #4c8dff;
  border-radius: 50%;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.loading-state.dark {
  color: #9cacc0;
}

.loading-state.dark .loading-dot {
  border-color: #2a394e;
  border-top-color: #4c8dff;
}
