.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 48rpx;
}

/* 转圈 spinner（比普通 loading 更大、更醒目） */
.loading-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #dbe5f1;
  border-top-color: #4278ed;
  border-radius: 50%;
  -webkit-animation: loading-spin 0.9s linear infinite;
  animation: loading-spin 0.9s linear infinite;
}

@-webkit-keyframes loading-spin {
  from {
    -webkit-transform: rotate(0deg);
    transform: rotate(0deg);
  }
  to {
    -webkit-transform: rotate(360deg);
    transform: rotate(360deg);
  }
}

@keyframes loading-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.loading-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
}

.loading-text {
  color: #33465e;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.loading-desc {
  margin-top: 10rpx;
  color: #8a98aa;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.loading-state.dark .loading-spinner {
  border-color: #2a394e;
  border-top-color: #6fa3ff;
}

.loading-state.dark .loading-text {
  color: #f5f7fb;
}

.loading-state.dark .loading-desc {
  color: #9cacc0;
}

/* ============ 骨架预览行 ============ */
@keyframes loading-shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.loading-skeleton-rows {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
  width: 480rpx;
}

.loading-skeleton-row {
  height: 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e2eaf3 25%, #eef3f8 50%, #e2eaf3 75%);
  background-size: 200% 100%;
  animation: loading-shimmer 1.6s ease-in-out infinite;
}

.loading-skeleton-row.wide   { width: 100%; }
.loading-skeleton-row.medium { width: 72%; }
.loading-skeleton-row.narrow { width: 48%; }

/* 深色变体 */
.loading-state.dark .loading-skeleton-row {
  background: linear-gradient(90deg, #1c2b3e 25%, #243447 50%, #1c2b3e 75%);
  background-size: 200% 100%;
  animation: loading-shimmer 1.6s ease-in-out infinite;
}

