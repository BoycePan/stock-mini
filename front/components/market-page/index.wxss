/**
 * market-page 组件样式
 * 所有行情页公共样式统一维护在此，不再依赖外部 styles/market-page.wxss。
 * 浅色/深色双主题，深色选择器从 .market-page.theme-dark 开始（组件样式隔离）。
 */

/* 自定义组件宿主选择器：确保组件在父容器 flex 布局中占满 100% 高度并约束子 scroll-view */
:host,
market-page {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* 根节点布局：flex 列方向，撑满父容器，内部 scroll 区自适应剩余高度 */
.market-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  flex: 1;
  min-height: 0;
}

/* 内容滚动区：显式声明 height: 0 触发微信小程序 Flex 下 scroll-view 滚动 */
.content-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* 顶部信息行：状态 pill 靠左、更新时间靠右 */
.page-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 10rpx;
}

/* 交易状态 pill（开市=绿） */
.page-status {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid #cdeedb;
  border-radius: 30rpx;
  background: #effaf3;
  color: #1c9d59;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(28, 157, 89, 0.1);
}

/* 休市（非交易时段）状态：灰色 */
.page-status.rest {
  border-color: #dce5f1;
  background: #f2f6fb;
  color: #617188;
  box-shadow: 0 4rpx 12rpx rgba(97, 113, 136, 0.08);
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #24b86b;
  box-shadow: 0 0 0 5rpx rgba(36, 184, 107, 0.12);
}

.page-status.rest .status-dot {
  background: #a5b0bf;
  box-shadow: 0 0 0 5rpx rgba(165, 176, 191, 0.14);
}

/* 数据更新时间（右对齐，长文本省略） */
.update-time {
  min-width: 0;
  margin-left: 24rpx;
  color: #8a98aa;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 底部占位：避免内容被悬浮 TabBar 遮挡 */
.bottom-space {
  height: 150rpx;
  height: calc(122rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* 深色主题（选择器从 .market-page.theme-dark 开始，组件样式隔离） */
.market-page.theme-dark .page-status {
  border-color: #2b4a3c;
  background: #1e3a2e;
  color: #6fd79a;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.market-page.theme-dark .page-status.rest {
  border-color: #2b3d57;
  background: #1d2b40;
  color: #9db4d4;
}

.market-page.theme-dark .status-dot {
  background: #34d37d;
  box-shadow: 0 0 0 5rpx rgba(52, 211, 125, 0.16);
}

.market-page.theme-dark .page-status.rest .status-dot {
  background: #7e93b0;
  box-shadow: 0 0 0 5rpx rgba(126, 147, 176, 0.18);
}
