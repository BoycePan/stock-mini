/**
 * market-page 组件样式
 * 所有行情页公共样式统一维护在此，不再依赖外部 styles/market-page.wxss。
 * 浅色/深色双主题，深色选择器从 .market-page.theme-dark 开始（组件样式隔离）。
 */

/* 自定义组件宿主选择器：确保组件在父容器 flex 布局中占满 100% 高度并约束子 scroll-view */
:host {
  display: flex;
  flex-direction: column;
  flex: 1;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* 根节点布局：flex 列方向，撑满父容器，内部 scroll 区自适应剩余高度 */
.market-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  flex: 1;
  min-height: 0;
}

/* 内容滚动区：显式声明 height: 0 触发微信小程序 Flex 下 scroll-view 滚动 */
.content-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* 顶部信息行：状态 pill 靠左、更新时间靠右 */
.page-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 10rpx;
}

/* 交易状态 pill（开市=绿） */
.page-status {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid #cdeedb;
  border-radius: 30rpx;
  background: #effaf3;
  color: #1c9d59;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(28, 157, 89, 0.1);
}

/* 休市（非交易时段）状态：灰色 */
.page-status.rest {
  border-color: #dce5f1;
  background: #f2f6fb;
  color: #617188;
  box-shadow: 0 4rpx 12rpx rgba(97, 113, 136, 0.08);
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #24b86b;
  box-shadow: 0 0 0 5rpx rgba(36, 184, 107, 0.12);
}

.page-status.rest .status-dot {
  background: #a5b0bf;
  box-shadow: 0 0 0 5rpx rgba(165, 176, 191, 0.14);
}

/* 数据更新时间（右对齐，长文本省略） */
.update-time {
  min-width: 0;
  margin-left: 24rpx;
  color: #8a98aa;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 底部占位：避免内容被悬浮 TabBar 遮挡 */
.bottom-space {
  height: 150rpx;
  height: calc(122rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* 深色主题（选择器从 .market-page.theme-dark 开始，组件样式隔离） */
.market-page.theme-dark .page-status {
  border-color: #2b4a3c;
  background: #1e3a2e;
  color: #6fd79a;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.market-page.theme-dark .page-status.rest {
  border-color: #2b3d57;
  background: #1d2b40;
  color: #9db4d4;
}

.market-page.theme-dark .status-dot {
  background: #34d37d;
  box-shadow: 0 0 0 5rpx rgba(52, 211, 125, 0.16);
}

.market-page.theme-dark .page-status.rest .status-dot {
  background: #7e93b0;
  box-shadow: 0 0 0 5rpx rgba(126, 147, 176, 0.18);
}

/* ============ 分享海报：隐藏画布（移出屏幕，宽 750 与海报设计坐标系一致） ============ */
.share-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 2400px;
}

/* 分享海报预览弹窗 */
.share-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(12, 18, 28, 0.62);
}

.share-modal-panel {
  width: 100%;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.22);
}

.share-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.share-modal-title {
  color: #152338;
  font-size: 30rpx;
  font-weight: 700;
}

.share-wm-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.share-wm-label {
  color: #718096;
  font-size: 24rpx;
}

.share-preview-scroll {
  max-height: 58vh;
  border-radius: 16rpx;
  background: #0c1220;
  overflow: hidden;
}

.share-preview-img {
  display: block;
  width: 100%;
}

.share-modal-tip {
  margin: 16rpx 0 18rpx;
  color: #99a6b7;
  font-size: 22rpx;
  text-align: center;
}

.share-modal-actions {
  display: flex;
  gap: 14rpx;
}

.share-act-close,
.share-act-forward,
.share-act-save {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.share-act-forward {
  background: linear-gradient(135deg, #1a2332, #2a3648);
  color: #f5efe3;
}

.share-act-save {
  background: linear-gradient(135deg, #4278ed, #3a67d6);
  color: #ffffff;
}

.share-act-close {
  background: #f0f3f8;
  color: #5c6675;
}

/* 深色主题 */
.market-page.theme-dark .share-modal-panel {
  background: #1a2637;
}

.market-page.theme-dark .share-modal-title {
  color: #f5f7fb;
}

.market-page.theme-dark .share-wm-label {
  color: #9cacc0;
}

.market-page.theme-dark .share-modal-tip {
  color: #9cacc0;
}

.market-page.theme-dark .share-act-forward {
  background: linear-gradient(135deg, #24334a, #2f415c);
  color: #f5efe3;
}

.market-page.theme-dark .share-act-save {
  background: linear-gradient(135deg, #6fa3ff, #5b8cf0);
  color: #0d1524;
}

.market-page.theme-dark .share-act-close {
  background: #223248;
  color: #c6d2e2;
}
