<view class="market-page {{ theme === 'dark' ? 'theme-dark' : '' }}">
  <app-header
    showSearch="{{ showSearch }}"
    showShare="{{ showShare }}"
    posterShare="{{ showShare }}"
    bind:share="onShare"
  ></app-header>
  <view class="page-meta">
    <view class="page-status {{ statusTone }}"
      ><text class="status-dot"></text><text>{{ statusLabel }}</text></view
    >
    <view class="update-time">{{ updatedLabel }}</view>
  </view>
  <scroll-view scroll-y class="content-scroll">
    <loading-state
      wx:if="{{ loading }}"
      text="{{ loadingText }}"
      desc="{{ loadingDesc }}"
    ></loading-state>
    <view wx:elif="{{ error }}" class="error-card"
      ><text>{{ error }}</text
      ><button bindtap="onRetry">重新加载</button></view
    >
    <block wx:else>
      <section-card
        wx:for="{{ sections }}"
        wx:key="id"
        section="{{ item }}"
        bind:metrictap="onMetricTap"
      ></section-card>
    </block>
    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 分享海报：隐藏画布 + 预览弹窗 -->
  <canvas type="2d" id="shareCanvas" class="share-canvas-hidden"></canvas>
  <view wx:if="{{ shareModalVisible }}" class="share-modal-mask" bindtap="hideShareModal">
    <view class="share-modal-panel" catchtap="noop">
      <view class="share-modal-head">
        <text class="share-modal-title">分享海报</text>
        <view class="share-wm-row">
          <text class="share-wm-label">底部水印</text>
          <switch
            checked="{{ includeWatermark }}"
            bindchange="onWatermarkToggle"
            color="{{ theme === 'dark' ? '#6fa3ff' : '#4278ed' }}"
          />
        </view>
      </view>
      <scroll-view scroll-y class="share-preview-scroll">
        <image
          class="share-preview-img"
          mode="widthFix"
          showMenuByLongpress="{{ true }}"
          src="{{ sharePreviewPath }}"
        ></image>
      </scroll-view>
      <view class="share-modal-tip">长按图片可保存 / 分享</view>
      <view class="share-modal-actions">
        <view class="share-act-forward" bindtap="openShareImageMenu">转发</view>
        <view class="share-act-save" bindtap="saveShareImage">保存相册</view>
        <view class="share-act-close" bindtap="hideShareModal">关闭</view>
      </view>
    </view>
  </view>
</view>
