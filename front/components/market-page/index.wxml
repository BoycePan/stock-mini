<view class="market-page {{ theme === 'dark' ? 'theme-dark' : '' }}">
  <app-header showSearch="{{ showSearch }}" showShare="{{ showShare }}" bind:share="onShare"></app-header>
  <view class="page-meta">
    <view class="page-status {{ statusTone }}"
      ><text class="status-dot"></text><text>{{ statusLabel }}</text></view
    >
    <view class="update-time">{{ updatedLabel }}</view>
  </view>
  <scroll-view scroll-y class="content-scroll">
    <loading-state wx:if="{{ loading }}" text="{{ loadingText }}" desc="{{ loadingDesc }}"></loading-state>
    <view wx:elif="{{ error }}" class="error-card"
      ><text>{{ error }}</text
      ><button bindtap="onRetry">重新加载</button></view
    >
    <block wx:else>
      <section-card
        wx:for="{{ sections }}"
        wx:key="id"
        section="{{ item }}"
        bind:metrictap="onMetricTap"
      ></section-card>
    </block>
    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
