<view class="share-poster {{ theme === 'dark' ? 'theme-dark' : '' }}">
  <!-- 隐藏海报画布（宽 750 与海报设计坐标系一致，移出屏幕） -->
  <canvas type="2d" id="shareCanvas" class="share-canvas-hidden"></canvas>

  <!-- 分享海报预览弹窗 -->
  <view wx:if="{{ modalVisible }}" class="share-modal-mask" bindtap="hideModal">
    <view class="share-modal-panel" catchtap="noop">
      <view class="share-modal-head">
        <text class="share-modal-title">分享海报</text>
        <view class="share-wm-row">
          <text class="share-wm-label">水印</text>
          <switch
            checked="{{ includeWatermark }}"
            bindchange="onWatermarkToggle"
            color="{{ theme === 'dark' ? '#6fa3ff' : '#4278ed' }}"
          />
        </view>
      </view>
      <scroll-view scroll-y class="share-preview-scroll">
        <image
          class="share-preview-img"
          mode="widthFix"
          showMenuByLongpress="{{ true }}"
          src="{{ sharePreviewPath }}"
        ></image>
      </scroll-view>
      <view class="share-modal-tip">长按图片可保存 / 分享</view>
      <view class="share-modal-actions">
        <view class="share-act-forward" bindtap="openShareImageMenu">转发</view>
        <view class="share-act-save" bindtap="saveShareImage">保存相册</view>
        <view class="share-act-close" bindtap="hideModal">关闭</view>
      </view>
    </view>
  </view>
</view>
