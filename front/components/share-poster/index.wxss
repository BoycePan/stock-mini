/**
 * share-poster 组件样式（K 线图页面分享海报）
 * 浅色/深色双主题，深色选择器从 .share-poster.theme-dark 开始（组件样式隔离，
 * 不依赖全局深色规则）。海报本身固定深色底（share-poster.ts 绘制），
 * 弹窗 UI 跟随主题。
 */

/* 隐藏海报画布：移出屏幕，宽 750 与海报设计坐标系一致 */
.share-canvas-hidden {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 2400px;
}

/* 分享海报预览弹窗 */
.share-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background: rgba(12, 18, 28, 0.62);
}

.share-modal-panel {
  width: 100%;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.22);
}

.share-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.share-modal-title {
  color: #152338;
  font-size: 30rpx;
  font-weight: 700;
}

.share-wm-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.share-wm-label {
  color: #718096;
  font-size: 24rpx;
}

.share-preview-scroll {
  max-height: 58vh;
  border-radius: 16rpx;
  background: #0c1220;
  overflow: hidden;
}

.share-preview-img {
  display: block;
  width: 100%;
}

.share-modal-tip {
  margin: 16rpx 0 18rpx;
  color: #99a6b7;
  font-size: 22rpx;
  text-align: center;
}

.share-modal-actions {
  display: flex;
  gap: 14rpx;
}

.share-act-close,
.share-act-forward,
.share-act-save {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

/* open-type=share 的原生 button 会带默认样式（边框 / 背景 / 行高），统一重置与 view 版一致 */
.share-act-forward {
  margin: 0;
  line-height: 1.4;
  background: linear-gradient(135deg, #1a2332, #2a3648);
  color: #f5efe3;
}

.share-act-forward::after {
  border: none;
}

.share-act-save {
  background: linear-gradient(135deg, #4278ed, #3a67d6);
  color: #ffffff;
}

.share-act-close {
  background: #f0f3f8;
  color: #5c6675;
}

/* 卡片转发模式下「分享原图」次级入口（可发朋友圈） */
.share-modal-extra {
  margin-top: 20rpx;
  text-align: center;
}

.share-extra-text {
  color: #718096;
  font-size: 24rpx;
  text-decoration: underline;
}

/* 深色主题 */
.share-poster.theme-dark .share-modal-panel {
  background: #1a2637;
}

.share-poster.theme-dark .share-modal-title {
  color: #f5f7fb;
}

.share-poster.theme-dark .share-wm-label {
  color: #9cacc0;
}

.share-poster.theme-dark .share-modal-tip {
  color: #9cacc0;
}

.share-poster.theme-dark .share-act-forward {
  background: linear-gradient(135deg, #24334a, #2f415c);
  color: #f5efe3;
}

.share-poster.theme-dark .share-act-save {
  background: linear-gradient(135deg, #6fa3ff, #5b8cf0);
  color: #0d1524;
}

.share-poster.theme-dark .share-act-close {
  background: #223248;
  color: #c6d2e2;
}

.share-poster.theme-dark .share-extra-text {
  color: #9cacc0;
}
