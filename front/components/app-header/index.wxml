<view class="header {{theme === 'dark' ? 'dark' : ''}} {{showBrand ? '' : 'no-brand'}}" style="{{ headerStyle }}">
  <view class="brand">
    <view
      wx:if="{{ showBack }}"
      class="back-button"
      bindtap="onBack"
      hover-class="back-button-hover"
    >
      <text class="back-arrow">‹</text>
      <text class="back-label">返回</text>
    </view>
    <view wx:if="{{ showBrand }}" class="brand-mark">◎</view>
    <text class="brand-title">{{ title }}</text>
  </view>
  <view wx:if="{{ showShare || showSearch }}" class="header-actions">
    <button wx:if="{{ showSearch }}" class="share-button" bindtap="onSearch">🔍 搜索</button>
    <button wx:if="{{ showShare }}" class="share-button" bindtap="onShare">↗ 分享</button>
    <view class="system-actions"
      ><text>•••</text><text class="divider">|</text><text>−</text><text class="divider">|</text
      ><text class="mini-dot">◉</text></view
    >
  </view>
  <view wx:else class="system-actions solo"
    ><text>•••</text><text class="divider">|</text><text>−</text><text class="divider">|</text
    ><text class="mini-dot">◉</text></view
  >
</view>
