.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 12rpx 0;
}

.brand {
  display: flex;
  align-items: center;
  min-width: 0;
  transform: translateY(-8rpx);
}

.back-button {
  display: flex;
  align-items: center;
  /* 文案过长时只省略标题，不允许压缩返回按钮 */
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 10rpx 20rpx 10rpx 14rpx;
  border: 1rpx solid #e1e8f0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #344257;
  box-shadow: 0 4rpx 14rpx rgba(62, 83, 111, 0.08);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.back-button-hover {
  opacity: 0.72;
  transform: scale(0.95);
}

.back-arrow {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.back-label {
  margin-left: 6rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.brand-mark {
  width: 68rpx;
  height: 68rpx;
  display: block;
  flex-shrink: 0;
  border-radius: 18rpx;
}

.no-brand .brand-title {
  margin-left: 0;
}

.brand-title {
  margin-left: 16rpx;
  min-width: 0;
  overflow: hidden;
  color: #152338;
  font-size: 40rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 不压缩右侧操作按钮，优先让标题省略 */
  flex-shrink: 0;
}

.header .share-button {
  /* 权重需 ≥0,2,0 才能压过框架默认 wx-button:not([size=mini])（0,1,1）的 width:184px / margin auto */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* 固定 100rpx 会裁掉「↗ 分享」文案（padding 已占 52rpx），用 auto 由内容撑开 */
  width: auto;
  flex: none;
  margin: 0;
  /* 高度 / 行高 / 圆角由 index.ts 按胶囊尺寸动态设置（inline style 覆盖此处兜底值） */
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  font-size: 25rpx;
  border: 1rpx solid #e1e8f0;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #344257;
  box-shadow: 0 4rpx 14rpx rgba(62, 83, 111, 0.08);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.header.dark,
.header.dark .share-button {
  background: rgba(24, 34, 49, 0.96);
  border-color: #2a394e;
  color: #f5f7fb;
}

.header.dark .back-button {
  border-color: #2a394e;
  background: rgba(24, 34, 49, 0.96);
  color: #e8eef7;
}

.header.dark .brand-title {
  color: #f5f7fb;
}

.header.dark .divider {
  color: #3d4f66;
}

.header.dark .mini-dot {
  color: #6eb7ff;
}