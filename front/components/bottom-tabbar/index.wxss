.tabbar {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  bottom: 0;
  height: 122rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(219, 227, 237, 0.9);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(55, 76, 105, 0.1);
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.tab {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3rpx;
  color: #9aa7b8;
}

.tab.active {
  color: #3f7df0;
  font-weight: 600;
}

.tab-icon {
  height: 52rpx;
  min-width: 74rpx;
  padding: 0 14rpx;
  border-radius: 22rpx;
  font-size: 42rpx;
  line-height: 52rpx;
  text-align: center;
}

.tab.active .tab-icon {
  background: #e8f1ff;
}

.tab-label {
  font-size: 22rpx;
  line-height: 32rpx;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.tabbar.dark {
  border-top-color: rgba(42, 57, 78, 0.9);
  background: rgba(24, 34, 49, 0.96);
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.25);
}

.tabbar.dark .tab {
  color: #9cacc0;
}

.tabbar.dark .tab.active {
  color: #6eb7ff;
}

.tabbar.dark .tab.active .tab-icon {
  background: #223248;
}
