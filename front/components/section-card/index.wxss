.section-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx 22rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.section-card.compact {
  padding-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  min-height: 54rpx;
  margin: 0 10rpx 22rpx;
}

.title-accent {
  width: 8rpx;
  height: 38rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #ff9c5c 0%, #ff625f 100%);
  box-shadow: 0 6rpx 12rpx rgba(255, 98, 95, 0.22);
}

.section-card.asia .title-accent {
  background: linear-gradient(180deg, #66a6ff 0%, #4c7ff5 100%);
  box-shadow: 0 6rpx 12rpx rgba(76, 127, 245, 0.22);
}

.section-card.finance .title-accent {
  background: linear-gradient(180deg, #a084ff 0%, #735ce5 100%);
  box-shadow: 0 6rpx 12rpx rgba(115, 92, 229, 0.22);
}

.section-title {
  color: #152338;
  font-size: 33rpx;
  font-weight: 700;
}

.section-badge {
  margin-left: auto;
  padding: 7rpx 16rpx;
  border: 1rpx solid #ffc8c4;
  border-radius: 24rpx;
  background: #fff5f4;
  color: #e65551;
  font-size: 24rpx;
  font-weight: 600;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric-card {
  min-height: 150rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 22rpx 20rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #f8fafc 0%, #f2f6fa 100%);
}

.metric-name {
  width: 100%;
  overflow: hidden;
  color: #46566b;
  font-size: 28rpx;
  line-height: 40rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.metric-icon {
  margin-right: 8rpx;
}

.metric-value {
  width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #152338;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.metric-change {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 32rpx;
  white-space: nowrap;
}

.metric-change.up {
  color: #eb514d;
  border-color: rgba(235, 81, 77, 0.18);
  background: rgba(235, 81, 77, 0.08);
}

.metric-change.down {
  color: #20a66a;
  border-color: rgba(32, 166, 106, 0.18);
  background: rgba(32, 166, 106, 0.08);
}

.metric-change.flat {
  color: #8492a5;
  border-color: rgba(132, 146, 165, 0.2);
  background: rgba(132, 146, 165, 0.08);
}

.metric-change text:first-child {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.section-card.asia .metric-card,
.section-card.metals .metric-card {
  min-height: 134rpx;
  padding-top: 20rpx;
  padding-bottom: 18rpx;
  border-color: #e2eaf3;
  background: #fff;
}

.section-card.asia .metric-name,
.section-card.metals .metric-name {
  font-size: 30rpx;
  font-weight: 600;
}

.section-card.asia .metric-change,
.section-card.metals .metric-change {
  font-size: 26rpx;
}

.section-card.finance .metric-card {
  min-height: 134rpx;
  border-color: #e5e1fa;
  background: linear-gradient(145deg, #fff 0%, #faf9ff 100%);
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.section-card.theme-dark {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.section-card.theme-dark .section-title,
.section-card.theme-dark .metric-value {
  color: #f5f7fb;
}

.section-card.theme-dark .metric-name {
  color: #e5ebf4;
}

.section-card.theme-dark .metric-card {
  border-color: #34465e;
  background: #223248;
}

.section-card.theme-dark .metric-change.flat {
  color: #9cacc0;
  border-color: rgba(156, 172, 192, 0.22);
  background: rgba(156, 172, 192, 0.1);
}

.section-card.theme-dark .section-badge {
  border-color: #7d4a56;
  background: #382a34;
  color: #ff9b9a;
}

.section-card.theme-dark.asia .metric-card,
.section-card.theme-dark.metals .metric-card {
  border-color: #34465e;
  background: #223248;
}

.section-card.theme-dark.finance .metric-card {
  border-color: #3a3358;
  background: #2a2440;
}
