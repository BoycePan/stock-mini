.section-card {
  position: relative;
  margin: 16rpx 20rpx 0;
  padding: 22rpx 18rpx 20rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 28rpx;
  background: #fff;
  /* 双层阴影：近阴影增强边界感，远阴影强化浮起感（亮色主题调淡，贴近背景色） */
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.04),
    0 12rpx 32rpx rgba(30, 60, 110, 0.06);
}

/* 页面第一个卡片：收紧顶部间距（配合 market-page 的 page-meta 底部 padding 减小） */
.section-card.first {
  margin-top: 4rpx;
}

.section-card.compact {
  padding-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  margin: 0 6rpx 16rpx;
}

.title-accent {
  width: 6rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 12rpx;
  background: linear-gradient(180deg, #ff9c5c 0%, #ff625f 100%);
  box-shadow: 0 4rpx 14rpx rgba(255, 98, 95, 0.28);
}

.section-card.asia .title-accent {
  background: linear-gradient(180deg, #66a6ff 0%, #4c7ff5 100%);
  box-shadow: 0 6rpx 12rpx rgba(76, 127, 245, 0.22);
}

.section-card.finance .title-accent {
  background: linear-gradient(180deg, #a084ff 0%, #735ce5 100%);
  box-shadow: 0 6rpx 12rpx rgba(115, 92, 229, 0.22);
}

.section-title {
  color: #152338;
  font-size: 33rpx;
  font-weight: 700;
}

.section-badge {
  margin-left: auto;
  padding: 7rpx 16rpx;
  border: 1rpx solid #ffc8c4;
  border-radius: 24rpx;
  background: #fff5f4;
  color: #e65551;
  font-size: 24rpx;
  font-weight: 600;
}

/* 盘面状态胶囊：板块标题右侧（盘中/午休/盘前/盘后/集合竞价/休市），
   用点 + 文案区分活跃度，颜色语义与全局 statusTone 对齐 */
.market-status {
  margin-left: 12rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid transparent;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

.market-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.market-status.active {
  color: #1f9a61;
  border-color: rgba(32, 166, 106, 0.28);
  background: rgba(32, 166, 106, 0.08);
}

.market-status.active .market-status-dot {
  background: #20a66a;
  box-shadow: 0 0 0 4rpx rgba(32, 166, 106, 0.12);
}

.market-status.quiet {
  color: #4278ed;
  border-color: rgba(66, 120, 237, 0.28);
  background: rgba(66, 120, 237, 0.08);
}

.market-status.quiet .market-status-dot {
  background: #4278ed;
}

.market-status.rest {
  color: #8492a5;
  border-color: rgba(132, 146, 165, 0.25);
  background: rgba(132, 146, 165, 0.08);
}

.market-status.rest .market-status-dot {
  background: #c3ccd8;
}

/* 布局：盘面状态按市场区域紧跟标题右侧；「i」说明按钮与徽标固定在卡片右侧，
   与说明按钮并存时依次排列（如行业板块 = 状态 + 说明按钮） */
.market-status+.section-badge {
  margin-left: 14rpx;
}

/* 说明图标：无徽标时推到最右，有徽标时徽标跟在图标右侧 */
.section-tip+.section-badge {
  margin-left: 14rpx;
}

.section-tip {
  margin-left: auto;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c6d2e0;
  border-radius: 50%;
  background: #f4f7fb;
  color: #7d8fa6;
  font-size: 24rpx;
  font-weight: 700;
  font-family: Georgia, serif;
  transition:
    transform 0.12s ease,
    opacity 0.12s ease;
}

.section-tip-hover {
  transform: scale(0.88);
  opacity: 0.75;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-card {
  position: relative;
  min-height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 16rpx;
  border: 1rpx solid #e2f0ff;
  border-radius: 20rpx;
  background: #ebf1f9;
  /* 亮色主题：底色略深于白色外卡以分层（呼应页面背景 #eef3f8），
     极淡蓝边收边 + 贴近背景色的淡阴影，区分但不突兀 */
  box-shadow:
    0 2rpx 6rpx rgba(30, 60, 110, 0.04),
    0 8rpx 20rpx rgba(30, 60, 110, 0.05);
}

.metric-name-row {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 图标块：Emoji 展示容器，仅装饰用途 */
.metric-icon-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: rgba(66, 120, 237, 0.1);
}

.metric-icon {
  font-size: 26rpx;
  line-height: 1;
}

.metric-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #46566b;
  font-size: 28rpx;
  line-height: 40rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 数据来源小徽标（如「个股」）：紧跟名称右侧，名称过长时优先省略名称 */
.metric-tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.32);
  border-radius: 18rpx;
  background: rgba(66, 120, 237, 0.08);
  color: #4278ed;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

/* 「分时」角标：示意卡片可点击查看当日分时。贴在卡片右上角的角标，
   右上/左下圆角与面板角标同款；去掉边框与渐变，仅保留极淡底色，弱化存在感 */
.minute-tag {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  margin: 0;
  padding: 2rpx 8rpx;
  border: none;
  border-radius: 0 20rpx 0 12rpx;
  background: rgba(66, 120, 237, 0.05);
  color: #8ba3c6;
  box-sizing: border-box;
  font-size: 17rpx;
  font-weight: 400;
  line-height: 26rpx;
  white-space: nowrap;
}

/* 有「分时」角标的卡片：名称行右侧让位，避免名称/来源徽标钻到角标下方 */
.metric-card.minute-badge-card .metric-name-row {
  /* padding-right: 60rpx; */
}

/* 面板右上角「分时」小角标（行业板块等整面板场景）：代替逐卡片内联标签，
   收在卡片右上角内侧的小胶囊，弱化描边与底色，不与「i」说明、来源徽标抢眼 */
.minute-corner-badge {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  z-index: 2;
  padding: 2rpx 8rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.22);
  border-radius: 0 28rpx 0 16rpx;
  background: rgba(66, 120, 237, 0.07);
  color: #6a8fe0;
  box-sizing: border-box;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 26rpx;
  white-space: nowrap;
}

/* 有右上角角标时，标题行让出右侧空间，避免与「A股时段」等徽标重叠 */
.section-card.minute-corner .section-title-row {
  padding-right: 18rpx;
}

/* 价格 + 涨跌幅同行容器 */
.metric-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 8rpx;
}

.metric-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #152338;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 条目更新时间（如「09:53 更新」）：价格下方的次要小字，右对齐（对齐涨跌徽标），仅在有值时渲染 */
.metric-updated {
  margin-top: 4rpx;
  color: #99a6b7;
  font-size: 20rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: right;
}

.metric-change {
  display: inline-flex;
  align-items: center;
  align-self: center;
  flex-shrink: 1;
  margin-top: 0;
  margin-left: auto;
  padding: 5rpx 8rpx;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-change.up {
  color: #eb514d;
  border-color: rgba(235, 81, 77, 0.18);
  background: rgba(235, 81, 77, 0.08);
}

.metric-change.down {
  color: #20a66a;
  border-color: rgba(32, 166, 106, 0.18);
  background: rgba(32, 166, 106, 0.08);
}

.metric-change.flat {
  color: #8492a5;
  border-color: rgba(132, 146, 165, 0.2);
  background: rgba(132, 146, 165, 0.08);
}

.metric-change .metric-change-prefix {
  margin-right: 4rpx;
  font-size: 25rpx;
}

.section-card.asia .metric-card,
.section-card.metals .metric-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.section-card.finance .metric-card {
  border: 1rpx solid #e6e1f6;
  background: #f4f3fb;
  box-shadow:
    0 2rpx 6rpx rgba(115, 92, 229, 0.05),
    0 8rpx 20rpx rgba(115, 92, 229, 0.06);
}

/* 单行布局：无价格条目（如行业板块只有涨跌幅）名称 + 涨跌徽标并排一行 */
.section-card .single-line-metric {
  min-height: 68rpx;
  padding: 12rpx 14rpx;
}

.section-card .single-line-metric .metric-icon-chip {
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
}

.section-card .single-line-metric .metric-icon {
  font-size: 22rpx;
}

.section-card .single-line-metric .metric-change {
  align-self: center;
  margin-top: 0;
  margin-left: 8rpx;
  /* 板块只展示涨跌幅文本：去掉胶囊边框/背景，把空间让给名称 */
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 600;
}

.section-card .single-line-metric .metric-change.up,
.section-card .single-line-metric .metric-change.down,
.section-card .single-line-metric .metric-change.flat {
  border-color: transparent;
  background: transparent;
}

/* 深色主题下同样去边框（避免 .theme-dark .metric-change.flat 的胶囊样式回填） */
.section-card.theme-dark .single-line-metric .metric-change.up,
.section-card.theme-dark .single-line-metric .metric-change.down,
.section-card.theme-dark .single-line-metric .metric-change.flat {
  border-color: transparent;
  background: transparent;
}

.section-card .single-line-metric .metric-change .metric-change-prefix {
  margin-right: 4rpx;
  font-size: 22rpx;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.section-card.theme-dark {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.14),
    0 8rpx 32rpx rgba(0, 0, 0, 0.22);
}

.section-card.theme-dark .section-title,
.section-card.theme-dark .metric-value {
  color: #f5f7fb;
}

.section-card.theme-dark .metric-updated {
  color: #9cacc0;
}

.section-card.theme-dark .metric-name {
  color: #e5ebf4;
}

.section-card.theme-dark .metric-icon-chip {
  background: rgba(111, 163, 255, 0.16);
}

.section-card.theme-dark .metric-card {
  border-color: #2f4260;
  background: #1f3148;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.section-card.theme-dark .metric-change.flat {
  color: #9cacc0;
  border-color: rgba(156, 172, 192, 0.22);
  background: rgba(156, 172, 192, 0.1);
}

.section-card.theme-dark .section-badge {
  border-color: #7d4a56;
  background: #382a34;
  color: #ff9b9a;
}

.section-card.theme-dark .market-status.active {
  color: #3fbf7f;
  border-color: rgba(63, 191, 127, 0.32);
  background: rgba(63, 191, 127, 0.12);
}

.section-card.theme-dark .market-status.quiet {
  color: #6fa3ff;
  border-color: rgba(111, 163, 255, 0.32);
  background: rgba(111, 163, 255, 0.12);
}

.section-card.theme-dark .market-status.rest {
  color: #9cacc0;
  border-color: rgba(156, 172, 192, 0.25);
  background: rgba(156, 172, 192, 0.1);
}

.section-card.theme-dark .section-tip {
  border-color: #43536a;
  background: #2b3a4e;
  color: #9cacc0;
}

.section-card.theme-dark .metric-tag {
  border-color: rgba(111, 163, 255, 0.4);
  background: rgba(111, 163, 255, 0.14);
  color: #6fa3ff;
}

/* 「分时」角标深色变体：极淡底色随主题切换，覆盖上方通用 metric-tag 深色规则 */
.section-card.theme-dark .metric-card .minute-tag {
  background: rgba(111, 163, 255, 0.07);
  color: #9cacc0;
}

.section-card.theme-dark .minute-corner-badge {
  border-color: rgba(111, 163, 255, 0.28);
  background: rgba(111, 163, 255, 0.1);
  color: #6fa3ff;
}

.section-card.theme-dark.finance .metric-card {
  border-color: #3a3358;
  background: #2a2440;
}

/* 数值变动时的轻微跳动动画（时长与 index.ts 的 BUMP_DURATION_MS 保持一致） */
@keyframes metric-bump {
  0% {
    transform: translateY(0) scale(1);
  }

  30% {
    transform: translateY(-3rpx) scale(1.05);
  }

  60% {
    transform: translateY(1rpx) scale(0.99);
  }

  100% {
    transform: translateY(0) scale(1);
  }
}

.metric-value.bump,
.metric-change.bump {
  animation: metric-bump 0.45s ease;
  transform-origin: left center;
}

/* ============ 骨架占位条（组件样式隔离，须在组件内复写动画） ============ */
@keyframes section-card-shimmer {
  0% {
    background-position: 200% 0;
  }

  100% {
    background-position: -200% 0;
  }
}

/* 价格区骨架条：与 .metric-value 同行高，宽度固定撑开空间 */
.metric-value-skeleton {
  height: 44rpx;
  width: 120rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e2eaf3 25%, #eef3f8 50%, #e2eaf3 75%);
  background-size: 200% 100%;
  animation: section-card-shimmer 1.6s ease-in-out infinite;
}

/* 深色变体 */
.section-card.theme-dark .metric-value-skeleton {
  background: linear-gradient(90deg, #1c2b3e 25%, #243447 50%, #1c2b3e 75%);
  background-size: 200% 100%;
  animation: section-card-shimmer 1.6s ease-in-out infinite;
}