.section-card {
  position: relative;
  margin: 16rpx 20rpx 0;
  padding: 22rpx 18rpx 20rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.section-card.compact {
  padding-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  margin: 0 6rpx 16rpx;
}

.title-accent {
  width: 8rpx;
  height: 38rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #ff9c5c 0%, #ff625f 100%);
  box-shadow: 0 6rpx 12rpx rgba(255, 98, 95, 0.22);
}

.section-card.asia .title-accent {
  background: linear-gradient(180deg, #66a6ff 0%, #4c7ff5 100%);
  box-shadow: 0 6rpx 12rpx rgba(76, 127, 245, 0.22);
}

.section-card.finance .title-accent {
  background: linear-gradient(180deg, #a084ff 0%, #735ce5 100%);
  box-shadow: 0 6rpx 12rpx rgba(115, 92, 229, 0.22);
}

.section-title {
  color: #152338;
  font-size: 33rpx;
  font-weight: 700;
}

.section-badge {
  margin-left: auto;
  padding: 7rpx 16rpx;
  border: 1rpx solid #ffc8c4;
  border-radius: 24rpx;
  background: #fff5f4;
  color: #e65551;
  font-size: 24rpx;
  font-weight: 600;
}

/* 说明图标：无徽标时推到最右，有徽标时徽标跟在图标右侧 */
.section-tip + .section-badge {
  margin-left: 14rpx;
}

.section-tip {
  margin-left: auto;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #c6d2e0;
  border-radius: 50%;
  background: #f4f7fb;
  color: #7d8fa6;
  font-size: 24rpx;
  font-weight: 700;
  font-family: Georgia, serif;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.metric-card {
  min-height: 140rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 18rpx 16rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #f8fafc 0%, #f2f6fa 100%);
}

.metric-name-row {
  display: flex;
  align-items: center;
  width: 100%;
}

/* 图标块：Emoji 展示容器，仅装饰用途 */
.metric-icon-chip {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  margin-right: 12rpx;
  border-radius: 14rpx;
  background: rgba(66, 120, 237, 0.1);
}

.metric-icon {
  font-size: 26rpx;
  line-height: 1;
}

.metric-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #46566b;
  font-size: 28rpx;
  line-height: 40rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 数据来源小徽标（如「个股」）：紧跟名称右侧，名称过长时优先省略名称 */
.metric-tag {
  flex-shrink: 0;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.32);
  border-radius: 18rpx;
  background: rgba(66, 120, 237, 0.08);
  color: #4278ed;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 30rpx;
  white-space: nowrap;
}

/* 「分时」角标：示意卡片可点击查看当日分时，虚线描边与来源徽标区分 */
.minute-tag {
  border-style: dashed;
  color: #6a8fe0;
}

/* 面板右上角「分时」小角标（行业板块等整面板场景）：代替逐卡片内联标签，
   贴在面板右上角，虚线描边与「i」说明、来源徽标区分 */
.minute-corner-badge {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  z-index: 2;
  padding: 6rpx 12rpx 6rpx;
  border: 1rpx dashed rgba(66, 120, 237, 0.5);
  border-radius: 0 27rpx 0 18rpx;
  background: rgba(66, 120, 237, 0.1);
  color: #4278ed;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
  white-space: nowrap;
}

/* 有右上角角标时，标题行让出右侧空间，避免与「A股时段」等徽标重叠 */
.section-card.minute-corner .section-title-row {
  padding-right: 50rpx;
}

/* 价格 + 涨跌幅同行容器 */
.metric-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 8rpx;
}

.metric-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #152338;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 44rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 条目更新时间（如「09:53 更新」）：价格下方的次要小字，右对齐（对齐涨跌徽标），仅在有值时渲染 */
.metric-updated {
  margin-top: 4rpx;
  color: #99a6b7;
  font-size: 20rpx;
  line-height: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-align: right;
}

.metric-change {
  display: inline-flex;
  align-items: center;
  align-self: center;
  flex-shrink: 1;
  margin-top: 0;
  margin-left: auto;
  padding: 5rpx 8rpx;
  border: 1rpx solid transparent;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric-change.up {
  color: #eb514d;
  border-color: rgba(235, 81, 77, 0.18);
  background: rgba(235, 81, 77, 0.08);
}

.metric-change.down {
  color: #20a66a;
  border-color: rgba(32, 166, 106, 0.18);
  background: rgba(32, 166, 106, 0.08);
}

.metric-change.flat {
  color: #8492a5;
  border-color: rgba(132, 146, 165, 0.2);
  background: rgba(132, 146, 165, 0.08);
}

.metric-change text:first-child {
  margin-right: 4rpx;
  font-size: 22rpx;
}

.section-card.asia .metric-card,
.section-card.metals .metric-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.section-card.finance .metric-card {
  border-color: #e5e1fa;
  background: linear-gradient(145deg, #fff 0%, #faf9ff 100%);
}

/* 单行布局：无价格条目（如行业板块只有涨跌幅）名称 + 涨跌徽标并排一行 */
.section-card .single-line-metric {
  min-height: 68rpx;
  padding: 12rpx 14rpx;
}

.section-card .single-line-metric .metric-icon-chip {
  width: 38rpx;
  height: 38rpx;
  margin-right: 10rpx;
}

.section-card .single-line-metric .metric-icon {
  font-size: 22rpx;
}

.section-card .single-line-metric .metric-change {
  align-self: center;
  margin-top: 0;
  margin-left: 8rpx;
  /* 板块只展示涨跌幅文本：去掉胶囊边框/背景，把空间让给名称 */
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 500;
}

.section-card .single-line-metric .metric-change.up,
.section-card .single-line-metric .metric-change.down,
.section-card .single-line-metric .metric-change.flat {
  border-color: transparent;
  background: transparent;
}

/* 深色主题下同样去边框（避免 .theme-dark .metric-change.flat 的胶囊样式回填） */
.section-card.theme-dark .single-line-metric .metric-change.up,
.section-card.theme-dark .single-line-metric .metric-change.down,
.section-card.theme-dark .single-line-metric .metric-change.flat {
  border-color: transparent;
  background: transparent;
}

.section-card .single-line-metric .metric-change text:first-child {
  margin-right: 4rpx;
  font-size: 22rpx;
}

/* 深色主题（组件样式隔离，必须写在组件自身 wxss 内） */
.section-card.theme-dark {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.section-card.theme-dark .section-title,
.section-card.theme-dark .metric-value {
  color: #f5f7fb;
}

.section-card.theme-dark .metric-updated {
  color: #9cacc0;
}

.section-card.theme-dark .metric-name {
  color: #e5ebf4;
}

.section-card.theme-dark .metric-icon-chip {
  background: rgba(111, 163, 255, 0.16);
}

.section-card.theme-dark .metric-card {
  border-color: #34465e;
  background: #223248;
}

.section-card.theme-dark .metric-change.flat {
  color: #9cacc0;
  border-color: rgba(156, 172, 192, 0.22);
  background: rgba(156, 172, 192, 0.1);
}

.section-card.theme-dark .section-badge {
  border-color: #7d4a56;
  background: #382a34;
  color: #ff9b9a;
}

.section-card.theme-dark .section-tip {
  border-color: #43536a;
  background: #2b3a4e;
  color: #9cacc0;
}

.section-card.theme-dark .metric-tag {
  border-color: rgba(111, 163, 255, 0.4);
  background: rgba(111, 163, 255, 0.14);
  color: #6fa3ff;
}

.section-card.theme-dark .minute-corner-badge {
  border-color: rgba(111, 163, 255, 0.5);
  background: rgba(111, 163, 255, 0.14);
  color: #6fa3ff;
}

.section-card.theme-dark.finance .metric-card {
  border-color: #3a3358;
  background: #2a2440;
}

/* 数值变动时的轻微跳动动画（时长与 index.ts 的 BUMP_DURATION_MS 保持一致） */
@keyframes metric-bump {
  0% {
    transform: translateY(0) scale(1);
  }
  30% {
    transform: translateY(-3rpx) scale(1.05);
  }
  60% {
    transform: translateY(1rpx) scale(0.99);
  }
  100% {
    transform: translateY(0) scale(1);
  }
}

.metric-value.bump,
.metric-change.bump {
  animation: metric-bump 0.45s ease;
  transform-origin: left center;
}
