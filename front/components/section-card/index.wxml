<view
  class="section-card {{ section.tone }} {{ first ? 'first' : '' }} {{
    compact ? 'compact' : ''
  }} {{ section.minuteCorner ? 'minute-corner' : '' }} {{ theme === 'dark' ? 'theme-dark' : '' }}"
>
  <view wx:if="{{ section.minuteCorner }}" class="minute-corner-badge"><text>分时</text></view>
  <view class="section-title-row">
    <view class="title-accent"></view>
    <text class="section-title">{{ section.title }}</text>

    <!-- 盘面状态胶囊：无 Tab 的面板（如指数区）在标题右侧展示；
         有 Tab 的面板（行业板块）改为每个 Tab 自带状态，避免与选中 Tab 重复 -->
    <view
      wx:if="{{ section.marketStatus && !section.tabs.length }}"
      class="market-status {{ section.marketTone }}"
    >
      <view class="market-status-dot"></view>
      <text>{{ section.marketStatus }}</text>
    </view>

    <view
      wx:if="{{ section.tip }}"
      class="section-tip"
      hover-class="section-tip-hover"
      hover-stay-time="80"
      catchtap="onTipTap"
      aria-role="button"
      aria-label="查看说明"
      ><text>i</text></view
    >

    <text wx:if="{{ section.badge }}" class="section-badge">{{ section.badge }}</text>
  </view>

  <!-- 面板内 Tab 切换条（如「行业板块」的 A股 / 美股）：两个市场的数据已同时备好，
       点 Tab 即时切换；每个 Tab 自带该市场的盘面状态（色调语义与状态胶囊一致：
       绿=盘中 / 蓝=盘前盘后午休竞价 / 灰=休市），两个市场此刻的状态一眼可比。
       选中态由页面 / store 持有并投影数据（见 index.ts onTabTap） -->
  <view wx:if="{{ section.tabs.length }}" class="section-tabs">
    <view
      wx:for="{{ section.tabs }}"
      wx:key="key"
      class="section-tab {{ section.activeTab === item.key ? 'section-tab-active' : '' }}"
      data-key="{{ item.key }}"
      hover-class="section-tab-hover"
      hover-stay-time="80"
      catchtap="onTabTap"
      aria-role="button"
      aria-label="{{ item.label }}{{ item.marketStatusShort ? '，' + item.marketStatusShort : '' }}{{
        section.activeTab === item.key ? '，当前选中' : ''
      }}"
    >
      <text class="section-tab-label">{{ item.label }}</text>
      <view wx:if="{{ item.marketStatusShort }}" class="section-tab-status {{ item.marketTone }}">
        <view class="section-tab-status-dot"></view>
        <text class="section-tab-status-text">{{ item.marketStatusShort }}</text>
      </view>
    </view>
  </view>

  <view class="metric-grid">
    <block wx:for="{{ section.metrics }}" wx:key="id">
      <!-- 特殊入口卡（如 美股指数区「市值TOP100」）：整行渐变横幅，区别于普通行情卡片 -->
      <view
        wx:if="{{ item.featured }}"
        class="featured-card"
        data-index="{{ index }}"
        bindtap="onMetricTap"
        hover-class="featured-hover"
      >
        <view wx:if="{{ item.iconImage }}" class="featured-icon">
          <image
            class="featured-icon-img"
            src="{{ item.iconImage }}"
            mode="aspectFit"
          ></image>
        </view>
        <view wx:elif="{{ item.icon }}" class="featured-icon"
          ><text>{{ item.icon }}</text></view
        >
        <view class="featured-body">
          <text class="featured-title">{{ item.name }}</text>
          <text wx:if="{{ item.featuredDesc }}" class="featured-desc"
            >{{ item.featuredDesc }}</text
          >
        </view>
        <t-icon
          class="featured-arrow"
          name="chevron-right"
          size="36rpx"
          color="{{ theme === 'dark' ? '#6fa3ff' : '#4278ed' }}"
        />
      </view>
      <view
        wx:elif="{{ !item.featured }}"
        class="metric-card {{ compact ? 'compact-metric' : '' }} {{
          section.singleLine ? 'single-line-metric' : ''
        }} {{ item.minuteAvailable && !section.minuteCorner ? 'minute-badge-card' : '' }}"
        data-index="{{ index }}"
        bindtap="onMetricTap"
      >
        <view class="metric-name-row">
          <view
            wx:if="{{ item.icon || item.iconImage }}"
            class="metric-icon-chip {{ item.iconImage ? 'metric-icon-chip-img' : '' }}"
          >
            <image
              wx:if="{{ item.iconImage }}"
              class="metric-icon-img"
              src="{{ item.iconImage }}"
              mode="aspectFit"
            ></image>
            <text wx:else class="metric-icon">{{ item.icon }}</text>
          </view>
          <text class="metric-name">{{ item.name }}</text>
          <block wx:for="{{ item.tags }}" wx:for-item="tag" wx:key="*this">
            <view class="metric-tag"
              ><text>{{ tag }}</text></view
            >
          </block>
          <view
            wx:if="{{ item.minuteAvailable && !section.minuteCorner }}"
            class="metric-tag minute-tag"
            ><text>分时</text></view
          >
          <view
            wx:if="{{ section.singleLine && !item.hideChange }}"
            class="metric-change {{ item.changeClass }} {{ bumpMap[item.id] ? 'bump' : '' }}"
            ><text class="metric-change-prefix">{{ item.direction }}</text
            ><text>{{ item.changeText }}</text></view
          >
        </view>
        <view wx:if="{{ !section.singleLine }}" class="metric-value-row">
          <!-- 有值时正常渲染，无值时显示骨架占位条 -->
          <text
            wx:if="{{ item.value }}"
            class="metric-value {{ bumpMap[item.id] ? 'bump' : '' }}"
            >{{ item.value }}</text
          >
          <view
            wx:elif="{{ !item.value }}"
            class="metric-value-skeleton loading-skeleton-inner"
          ></view>
          <view
            wx:if="{{ !item.hideChange }}"
            class="metric-change {{ item.changeClass }} {{ bumpMap[item.id] ? 'bump' : '' }}"
            ><text class="metric-change-prefix">{{ item.direction }}</text
            ><text>{{ item.changeText }}</text></view
          >
        </view>
        <view wx:if="{{ item.updatedAt }}" class="metric-updated">{{ item.updatedAt }}</view>
      </view>
    </block>
  </view>

  <info-dialog
    visible="{{ tipVisible }}"
    title="{{ section.tipTitle || section.title || '' }}"
    content="{{ section.tip || '' }}"
    bind:close="onCloseTip"
  ></info-dialog>
</view>
