<view class="section-card {{section.tone}} {{compact ? 'compact' : ''}}">
  <view class="section-title-row">
    <view class="title-accent"></view>
    <text class="section-title">{{section.title}}</text>
    <text wx:if="{{section.badge}}" class="section-badge">{{section.badge}}</text>
  </view>
  <view class="metric-grid">
    <block wx:for="{{section.metrics}}" wx:key="id">
      <view class="metric-card {{compact ? 'compact-metric' : ''}}" data-index="{{index}}" bindtap="onMetricTap">
        <view class="metric-name"><text wx:if="{{item.icon}}" class="metric-icon">{{item.icon}}</text><text>{{item.name}}</text></view>
        <text wx:if="{{item.value}}" class="metric-value">{{item.value}}</text>
        <view class="metric-change {{item.changeClass}}"><text>{{item.direction}}</text><text>{{item.changeText}}</text></view>
      </view>
    </block>
  </view>
</view>
