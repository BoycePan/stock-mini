.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
}

.loading,
.empty-wrap {
  margin-top: 18rpx;
  padding: 120rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  color: #718096;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.detail-card {
  margin-top: 18rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.detail-title {
  display: block;
  color: #1c2a3e;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.detail-meta {
  display: block;
  margin-top: 16rpx;
  color: #99a6b7;
  font-size: 22rpx;
}

.detail-summary {
  display: block;
  margin-top: 24rpx;
  color: #4a5a70;
  font-size: 27rpx;
  line-height: 42rpx;
}

.detail-link {
  margin-top: 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-link::after {
  border: 0;
}
