/* ============================================================
   布局容器
   ============================================================ */
.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
}

/* ============================================================
   空态 / 错误
   ============================================================ */
.empty-wrap {
  margin-top: 20rpx;
  padding: 120rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  color: #718096;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

/* ============================================================
   通用卡片
   ============================================================ */
.detail-card,
.link-card,
.guide-card {
  margin-top: 20rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 10rpx 36rpx rgba(64, 86, 116, 0.1);
  overflow: hidden;
}

/* ============================================================
   正文卡片 — 顶部强调色条
   ============================================================ */
.detail-accent-bar {
  height: 6rpx;
  background: linear-gradient(90deg, #4278ed 0%, #6fa3ff 55%, #9ec2ff 100%);
}

/* ============================================================
   元信息行（来源徽标 + 时间）
   ============================================================ */
.detail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 32rpx 36rpx 0;
}

.detail-source-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(66, 120, 237, 0.16);
  border-radius: 30rpx;
  background: linear-gradient(135deg, #eef3ff 0%, #dfeaff 100%);
}

.detail-source-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6fa3ff 0%, #4278ed 100%);
  box-shadow: 0 0 8rpx rgba(66, 120, 237, 0.45);
}

.detail-source-text {
  color: #3567d8;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.detail-time {
  color: #99a6b7;
  font-size: 22rpx;
  letter-spacing: 0.3rpx;
}

/* ============================================================
   标题（左侧强调条 + 主标题）
   ============================================================ */
.detail-title-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 28rpx 36rpx 0;
}

.detail-title-bar {
  flex: 0 0 8rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #6fa3ff 0%, #4278ed 100%);
  box-shadow: 0 4rpx 12rpx rgba(66, 120, 237, 0.35);
}

.detail-title {
  flex: 1;
  display: block;
  color: #1c2a3e;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* ============================================================
   装饰分割线（渐变线 + 菱形点缀）
   ============================================================ */
.detail-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 30rpx 36rpx 0;
}

.detail-divider-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #dde6f2 30%, #dde6f2 70%, transparent 100%);
}

.detail-divider-diamond {
  width: 12rpx;
  height: 12rpx;
  transform: rotate(45deg);
  border-radius: 3rpx;
  background: linear-gradient(135deg, #6fa3ff 0%, #4278ed 100%);
  box-shadow: 0 0 10rpx rgba(66, 120, 237, 0.4);
}

/* ============================================================
   rich-text 富文本正文
   ============================================================ */
.detail-rich {
  display: block;
  padding: 30rpx 36rpx 44rpx;
  color: #3d4c63;
  font-size: 30rpx;
  line-height: 2;
  letter-spacing: 0.3rpx;
  word-break: break-word;
}

/* ============================================================
   纯文本摘要（无 HTML 时）：导语高亮 + 正文
   ============================================================ */
.detail-summary {
  padding: 30rpx 36rpx 44rpx;
  color: #4a5a70;
  font-size: 30rpx;
  line-height: 2;
  letter-spacing: 0.3rpx;
  word-break: break-word;
  text-indent: 2em;
}

.detail-summary-lead {
  color: #3567d8;
  font-weight: 700;
}

.detail-summary-rest {
  color: #4a5a70;
}

/* ============================================================
   正文为空态
   ============================================================ */
.detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 52rpx 36rpx 44rpx;
  gap: 22rpx;
}

.detail-empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef3ff 0%, #dde9ff 100%);
  box-shadow: 0 10rpx 24rpx rgba(66, 120, 237, 0.16);
}

.detail-empty-icon {
  font-size: 52rpx;
  line-height: 1;
}

.detail-empty-text {
  color: #8b99ab;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

/* ============================================================
   原文链接卡片
   ============================================================ */
.link-card {
  padding: 30rpx 36rpx;
}

.link-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.link-icon {
  font-size: 28rpx;
}

.link-label {
  color: #152338;
  font-size: 29rpx;
  font-weight: 700;
}

.link-copied-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #e6f6ee;
}

.link-copied-text {
  color: #1c9d59;
  font-size: 22rpx;
  font-weight: 600;
}

.link-url {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border: 1rpx dashed #c6d3e8;
  border-radius: 18rpx;
  background: #f7f9fc;
}

.link-url-hover {
  opacity: 0.72;
}

.link-url-text {
  flex: 1;
  color: #5b6b80;
  font-size: 23rpx;
  line-height: 36rpx;
  word-break: break-all;
}

.link-copy-icon {
  flex: 0 0 auto;
  margin-left: 14rpx;
  color: #4278ed;
  font-size: 32rpx;
}

.detail-link {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #4278ed 0%, #6fa3ff 100%);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  white-space: nowrap;
  box-shadow: 0 8rpx 20rpx rgba(66, 120, 237, 0.28);
}

.detail-link-text {
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
  white-space: nowrap;
}

.detail-link-copied {
  background: linear-gradient(135deg, #20a66a 0%, #34c27a 100%);
  box-shadow: 0 8rpx 20rpx rgba(32, 166, 106, 0.28);
}

.detail-link-hover {
  opacity: 0.92;
  transform: scale(0.98);
}

.detail-link::after {
  border: 0;
}

/* ============================================================
   使用引导卡片
   ============================================================ */
.guide-card {
  padding: 30rpx 36rpx 34rpx;
}

.guide-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.guide-icon {
  font-size: 28rpx;
}

.guide-title {
  color: #152338;
  font-size: 29rpx;
  font-weight: 700;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
}

.guide-num {
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 auto;
  margin-right: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b9cf8 0%, #4278ed 100%);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 38rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(66, 120, 237, 0.32);
}

.guide-text {
  flex: 1;
  color: #46566b;
  font-size: 26rpx;
  line-height: 40rpx;
}

.guide-note-wrap {
  margin-top: 26rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.guide-note {
  color: #8b99ab;
  font-size: 23rpx;
  line-height: 36rpx;
}

/* ============================================================
   底部占位
   ============================================================ */
.bottom-space {
  height: 80rpx;
}

/* ============================================================
   深色主题覆盖
   ============================================================ */
.page.theme-dark .empty-wrap {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.2);
}

.page.theme-dark .detail-card,
.page.theme-dark .link-card,
.page.theme-dark .guide-card {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.24);
}

.page.theme-dark .detail-source-badge {
  border-color: rgba(111, 163, 255, 0.2);
  background: linear-gradient(135deg, #1e3a6e 0%, #243d72 100%);
}

.page.theme-dark .detail-source-text {
  color: #6fa3ff;
}

.page.theme-dark .detail-time {
  color: #9cacc0;
}

.page.theme-dark .detail-title {
  color: #f5f7fb;
}

.page.theme-dark .detail-divider-line {
  background: linear-gradient(90deg, transparent 0%, #2c3d53 30%, #2c3d53 70%, transparent 100%);
}

.page.theme-dark .detail-rich {
  color: #dfe6f0;
}

.page.theme-dark .detail-summary,
.page.theme-dark .detail-summary-rest {
  color: #e5ebf4;
}

.page.theme-dark .detail-summary-lead {
  color: #6fa3ff;
}

.page.theme-dark .detail-empty-icon-wrap {
  background: linear-gradient(135deg, #1e3a6e 0%, #243d72 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.3);
}

.page.theme-dark .detail-empty-text {
  color: #9cacc0;
}

.page.theme-dark .link-label,
.page.theme-dark .guide-title {
  color: #f5f7fb;
}

.page.theme-dark .link-copied-badge {
  background: #1c3d2e;
}

.page.theme-dark .link-copied-text {
  color: #3ec97a;
}

.page.theme-dark .link-url {
  border-color: #34465e;
  background: #223248;
}

.page.theme-dark .link-url-text {
  color: #b9c6d6;
}

.page.theme-dark .link-copy-icon {
  color: #6fa3ff;
}

.page.theme-dark .detail-link {
  background: linear-gradient(135deg, #3b6fd6 0%, #5a8fff 100%);
  box-shadow: 0 8rpx 20rpx rgba(59, 111, 214, 0.36);
}

.page.theme-dark .detail-link-copied {
  background: linear-gradient(135deg, #1a8c58 0%, #28b06e 100%);
  box-shadow: 0 8rpx 20rpx rgba(26, 140, 88, 0.36);
}

.page.theme-dark .guide-text {
  color: #b9c6d6;
}

.page.theme-dark .guide-note-wrap {
  background: #223248;
}

.page.theme-dark .guide-note {
  color: #9cacc0;
}
