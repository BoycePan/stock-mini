.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
}

.loading,
.empty-wrap {
  margin-top: 18rpx;
  padding: 120rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  color: #718096;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.detail-card,
.link-card,
.guide-card {
  margin-top: 18rpx;
  padding: 32rpx 28rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.detail-title {
  display: block;
  color: #1c2a3e;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  color: #99a6b7;
  font-size: 22rpx;
}

.detail-source {
  color: #2f6fed;
  font-weight: 600;
}

.meta-dot {
  margin: 0 10rpx;
}

.detail-summary {
  display: block;
  margin-top: 24rpx;
  color: #4a5a70;
  font-size: 27rpx;
  line-height: 42rpx;
}

.empty-summary {
  color: #8b99ab;
}

.link-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link-label {
  color: #152338;
  font-size: 28rpx;
  font-weight: 700;
}

.link-copied {
  color: #1c9d59;
  font-size: 22rpx;
  font-weight: 600;
}

.link-url {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx dashed #cbd7e5;
  border-radius: 16rpx;
  background: #f8fafc;
}

.link-url-hover {
  opacity: 0.7;
}

.link-url-text {
  flex: 1;
  color: #5b6b80;
  font-size: 23rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.link-copy-icon {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #2f6fed;
  font-size: 30rpx;
}

.detail-link {
  margin-top: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.detail-link-copied {
  background: #20a66a;
}

.detail-link::after {
  border: 0;
}

.guide-title {
  display: block;
  color: #152338;
  font-size: 28rpx;
  font-weight: 700;
}

.guide-step {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.guide-num {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 auto;
  margin-right: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b9cf8, #4c7ff0);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 36rpx;
  text-align: center;
}

.guide-text {
  flex: 1;
  color: #46566b;
  font-size: 25rpx;
  line-height: 38rpx;
}

.guide-note {
  display: block;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #dce5ef;
  color: #8b99ab;
  font-size: 22rpx;
  line-height: 34rpx;
}

.bottom-space {
  height: 80rpx;
}

/* dark theme */
.page.theme-dark .loading,
.page.theme-dark .empty-wrap,
.page.theme-dark .detail-card,
.page.theme-dark .link-card,
.page.theme-dark .guide-card {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.page.theme-dark .detail-title,
.page.theme-dark .link-label,
.page.theme-dark .guide-title {
  color: #f5f7fb;
}

.page.theme-dark .detail-summary,
.page.theme-dark .guide-text {
  color: #e5ebf4;
}

.page.theme-dark .detail-meta,
.page.theme-dark .empty-summary,
.page.theme-dark .guide-note {
  color: #9cacc0;
}

.page.theme-dark .link-url {
  border-color: #34465e;
  background: #223248;
}

.page.theme-dark .link-url-text {
  color: #b9c6d6;
}

.page.theme-dark .detail-link {
  background: #3b6fd6;
}
