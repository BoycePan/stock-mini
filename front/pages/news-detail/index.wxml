<view class="page theme-{{theme}}">
  <app-header title="新闻详情" showShare="{{true}}" posterShare="{{true}}" showBack="{{true}}" showBrand="{{false}}" bind:share="onSharePoster"></app-header>
  <scroll-view scroll-y class="content-scroll">
    <loading-state wx:if="{{loading}}" text="正在加载新闻详情" desc="正在为您获取完整内容，请稍候…"></loading-state>
    <view wx:elif="{{error && !news.title}}" class="empty-wrap">
      <empty-state title="新闻详情缺失"></empty-state>
    </view>
    <block wx:else>

      <!-- 正文卡片 -->
      <view class="detail-card" wx:if="{{news}}">
        <!-- 顶部强调色条 -->
        <view class="detail-accent-bar"></view>

        <!-- 来源徽标 + 时间 -->
        <view class="detail-meta" wx:if="{{news.source || news.time}}">
          <view wx:if="{{news.source}}" class="detail-source-badge">
            <view class="detail-source-dot"></view>
            <text class="detail-source-text">{{news.source}}</text>
          </view>
          <text wx:if="{{news.time}}" class="detail-time">{{news.time}}</text>
        </view>

        <!-- 标题（左侧强调条） -->
        <view class="detail-title-row">
          <view class="detail-title-bar"></view>
          <text class="detail-title">{{news.title}}</text>
        </view>

        <!-- 装饰分割线 -->
        <view class="detail-divider">
          <view class="detail-divider-line"></view>
          <view class="detail-divider-diamond"></view>
          <view class="detail-divider-line"></view>
        </view>

        <!-- 正文富文本 / 纯文本 -->
        <rich-text wx:if="{{richHtml}}" class="detail-rich" nodes="{{richHtml}}"></rich-text>
        <view wx:elif="{{news.summary}}" class="detail-summary">
          <block wx:if="{{summaryLead}}">
            <text class="detail-summary-lead">{{summaryLead}}</text>
            <text class="detail-summary-rest">{{summaryRest}}</text>
          </block>
          <text wx:else>{{news.summary}}</text>
        </view>
        <view wx:else class="detail-empty">
          <view class="detail-empty-icon-wrap">
            <text class="detail-empty-icon">📄</text>
          </view>
          <text class="detail-empty-text">原文摘要暂未获取，可复制下方链接到浏览器查看全文。</text>
        </view>
      </view>

      <!-- 原文链接卡片 -->
      <view class="link-card" wx:if="{{news.url}}">
        <view class="link-head">
          <view class="link-head-left">
            <text class="link-icon">🔗</text>
            <text class="link-label">原文链接</text>
          </view>
          <view wx:if="{{copied}}" class="link-copied-badge">
            <text class="link-copied-text">已复制 ✓</text>
          </view>
        </view>
        <view class="link-url" bindtap="onCopyLink" hover-class="link-url-hover">
          <text class="link-url-text">{{news.url}}</text>
          <text class="link-copy-icon">⧉</text>
        </view>
        <button class="detail-link {{copied ? 'detail-link-copied' : ''}}" hover-class="detail-link-hover" hover-stay-time="120" bindtap="onCopyLink">
          <text class="detail-link-text">{{copied ? '✓ 已复制，去浏览器打开' : '复制原文链接'}}</text>
        </button>
      </view>

      <!-- 打开引导卡片 -->
      <view class="guide-card">
        <view class="guide-head">
          <text class="guide-icon">💡</text>
          <text class="guide-title">如何在浏览器打开</text>
        </view>
        <view class="guide-step">
          <view class="guide-num"><text>1</text></view>
          <text class="guide-text">点击上方按钮复制原文链接</text>
        </view>
        <view class="guide-step">
          <view class="guide-num"><text>2</text></view>
          <text class="guide-text">打开手机浏览器（Safari / Chrome / 系统浏览器）</text>
        </view>
        <view class="guide-step">
          <view class="guide-num"><text>3</text></view>
          <text class="guide-text">在地址栏粘贴链接，即可查看完整原文</text>
        </view>
        <view class="guide-note-wrap">
          <text class="guide-note">小程序无法直接打开外部网页，请复制链接后在浏览器中访问。</text>
        </view>
      </view>

    </block>
    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 分享海报（隐藏画布 + 预览弹窗） -->
  <share-poster id="sharePoster" posterData="{{ posterData }}"></share-poster>
</view>
