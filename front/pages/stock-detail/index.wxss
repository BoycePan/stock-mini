/* 页面改为原生滚动：scroll-view 内的 2d canvas 在模拟器中不跟随滚动，
   改用页面级滚动后 canvas 随页面正常滚动 */
.page {
  display: block;
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.page-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #f5f8fc;
}

.page.theme-dark .page-header {
  background: #111827;
}

.content-scroll {
  padding: 0 24rpx;
}

/* 数据延迟免责提示 */
.data-notice {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #f3e6c8;
  border-radius: 20rpx;
  background: #fffaf0;
}

.notice-icon {
  flex-shrink: 0;
  width: 34rpx;
  height: 34rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #e8b04c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 34rpx;
  text-align: center;
}

.notice-text {
  flex: 1;
  color: #8a6d3b;
  font-size: 23rpx;
  line-height: 36rpx;
}

.page.theme-dark .data-notice {
  border-color: #4a4430;
  background: #26241a;
}

.page.theme-dark .notice-icon {
  background: #d9a54a;
  color: #1d1c14;
}

.page.theme-dark .notice-text {
  color: #d9c9a3;
}

.quote-card,
.panel,
.error-card {
  margin-top: 18rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.quote-card {
  background: linear-gradient(145deg, #fff 0%, #f8fbff 100%);
}

.quote-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.stock-name {
  display: block;
  color: #152338;
  font-size: 35rpx;
  font-weight: 700;
}

.stock-code {
  display: block;
  margin-top: 8rpx;
  color: #8a98aa;
  font-size: 23rpx;
}

.quote-price {
  text-align: right;
}

.price {
  display: block;
  color: #152338;
  font-size: 47rpx;
  font-weight: 750;
}

.quote-change {
  display: block;
  margin-top: 4rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.up {
  color: #eb514d;
}

.down {
  color: #20a66a;
}

.quote-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx 10rpx;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #edf1f6;
}

.quote-grid view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.quote-grid text:first-child {
  color: #8a98aa;
  font-size: 22rpx;
}

.quote-grid text:last-child {
  color: #34445a;
  font-size: 26rpx;
  font-weight: 600;
}

.panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #152338;
  font-size: 31rpx;
  font-weight: 700;
}

.scale-tabs {
  display: flex;
  gap: 20rpx;
  color: #8a98aa;
  font-size: 23rpx;
  font-weight: 400;
}

.scale-tabs .selected {
  color: #4278ed;
  font-weight: 600;
}

.kline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1f6;
  color: #66758a;
  font-size: 23rpx;
}

.news-row {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf1f6;
}

.news-row:last-child {
  border-bottom: 0;
}

.news-title {
  display: block;
  color: #2a3a50;
  font-size: 27rpx;
  line-height: 38rpx;
}

.news-time {
  display: block;
  margin-top: 8rpx;
  color: #99a6b7;
  font-size: 24rpx;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #718096;
  font-size: 27rpx;
}

.error-card button {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 25rpx;
}

.bottom-space {
  height: 40rpx;
}

/* 加载更多 */
.load-more {
  padding: 22rpx 0 6rpx;
  color: #4278ed;
  font-size: 25rpx;
  text-align: center;
}

.load-more.end {
  color: #99a6b7;
}

.page.theme-dark .load-more {
  color: #6fa3ff;
}

.page.theme-dark .load-more.end {
  color: #5b6a7f;
}

.page.theme-dark .error-card button {
  background: #233046;
  color: #6fa3ff;
}

.page.theme-dark .scale-tabs {
  color: #9cacc0;
}

.page.theme-dark .scale-tabs .selected {
  color: #6fa3ff;
}
