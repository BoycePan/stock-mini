<view class="page theme-{{ theme }} settings-page">
  <app-header showShare="{{ false }}"></app-header>
  <scroll-view scroll-y class="content-scroll">

    <!-- 用户信息卡片 -->
    <view class="user-card">
      <block wx:if="{{ isLoggedIn && user }}">
        <view class="avatar-ring">
          <image
            wx:if="{{ user.avatar_url }}"
            class="user-avatar"
            src="{{ user.avatar_url }}"
            mode="aspectFill"
          />
          <view wx:else class="user-avatar avatar-placeholder">👤</view>
        </view>
        <view class="user-info">
          <text class="user-name">{{ user.nickname || '微信用户' }}</text>
          <text class="user-meta">用户ID {{ user.id }}</text>
        </view>
        <view class="user-status online">已登录</view>
      </block>
      <view wx:else class="user-guest">
        <view class="avatar-ring">
          <view class="user-avatar avatar-placeholder">👤</view>
        </view>
        <view class="user-info">
          <text class="user-name">未登录</text>
          <text class="user-meta">打开行情页时将自动登录</text>
        </view>
        <view class="user-status offline">未登录</view>
      </view>
    </view>

    <!-- 上线公告横幅 -->
    <view class="banner">
      <view class="banner-icon">🚀</view>
      <view class="banner-copy">
        <text class="banner-title">小程序全新上线</text>
        <text class="banner-subtitle">更多模块持续更新中</text>
      </view>
      <view class="banner-badge">NEW</view>
    </view>

    <!-- 通用设置 -->
    <text class="section-heading">通用</text>
    <view class="setting-group">
      <view class="setting-row theme-row">
        <view class="row-icon-wrap theme">
          <t-icon name="mode-light" size="40rpx" class="row-icon-svg" />
        </view>
        <view class="row-main">
          <text class="row-label">主题模式</text>
          <text class="row-desc">自由切换浅色 / 深色外观</text>
        </view>
        <view class="theme-switch">
          <text
            class="theme-option {{ theme === 'light' ? 'selected' : '' }}"
            data-value="light"
            bindtap="onThemeChange"
          >浅色</text>
          <text
            class="theme-option {{ theme === 'dark' ? 'selected' : '' }}"
            data-value="dark"
            bindtap="onThemeChange"
          >深色</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <text class="section-heading">关于</text>
    <view class="setting-group">
      <view
        class="setting-row clickable"
        hover-class="row-hover"
        data-key="data-notice"
        bindtap="onServiceTap"
      >
        <view class="row-icon-wrap blue">
          <text class="row-emoji">📊</text>
        </view>
        <view class="row-main">
          <text class="row-label">数据说明</text>
          <text class="row-desc">数据来源、时效与准确性说明</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" class="row-arrow-icon" />
      </view>
      <view class="row-divider"></view>
      <view
        class="setting-row clickable"
        hover-class="row-hover"
        data-key="disclaimer"
        bindtap="onServiceTap"
      >
        <view class="row-icon-wrap orange">
          <text class="row-emoji">⚠️</text>
        </view>
        <view class="row-main">
          <text class="row-label">免责声明</text>
          <text class="row-desc">信息仅供参考，不构成投资建议</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" class="row-arrow-icon" />
      </view>
      <view class="row-divider"></view>
      <view
        class="setting-row clickable"
        hover-class="row-hover"
        data-key="agreement"
        bindtap="onServiceTap"
      >
        <view class="row-icon-wrap green">
          <text class="row-emoji">📄</text>
        </view>
        <view class="row-main">
          <text class="row-label">用户协议</text>
          <text class="row-desc">服务条款与用户行为规范</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" class="row-arrow-icon" />
      </view>
      <view class="row-divider"></view>
      <view
        class="setting-row clickable"
        hover-class="row-hover"
        data-key="privacy"
        bindtap="onServiceTap"
      >
        <view class="row-icon-wrap purple">
          <text class="row-emoji">🔒</text>
        </view>
        <view class="row-main">
          <text class="row-label">隐私政策</text>
          <text class="row-desc">信息收集、存储与你的权利</text>
        </view>
        <t-icon name="chevron-right" size="40rpx" class="row-arrow-icon" />
      </view>
    </view>

    <!-- 页脚 -->
    <view class="footer">
      <text class="footer-title">市场追踪助手</text>
      <text class="footer-sub">v{{ version }} · 数据仅供参考，不构成任何投资建议</text>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
  <bottom-tabbar active="{{ activeTab }}" bind:change="onTabChange"></bottom-tabbar>
</view>
