.content-scroll {
  height: calc(100vh - 112rpx);
  padding: 12rpx 24rpx 0;
}

.theme-card,
.promo-card,
.setting-section,
.follow-card {
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.theme-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 24rpx;
}

.theme-copy {
  display: flex;
  align-items: center;
  min-width: 0;
}

.theme-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 21rpx;
  background: linear-gradient(145deg, #eaf2ff 0%, #dce9ff 100%);
  color: #4c7ff5;
  font-size: 40rpx;
}

.theme-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

.theme-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #7b8ba1;
  font-size: 23rpx;
}

.theme-switch {
  display: flex;
  flex: 0 0 auto;
  padding: 6rpx;
  border-radius: 34rpx;
  background: #eef3f8;
}

.theme-option {
  padding: 14rpx 16rpx;
  border-radius: 27rpx;
  color: #65748a;
  font-size: 23rpx;
}

.theme-option.selected {
  background: #fff;
  color: #4278ed;
  box-shadow: 0 5rpx 14rpx rgba(76, 127, 255, 0.14);
}

.promo-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 30rpx 26rpx;
  border-color: #ffd5d1;
  background: linear-gradient(135deg, #fff8f6 0%, #fff1ef 100%);
}

.promo-title {
  display: block;
  color: #793d3a;
  font-size: 29rpx;
  font-weight: 700;
}

.promo-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #a06e6a;
  font-size: 23rpx;
}

.promo-button,
.primary-button {
  min-width: 142rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ff776f 0%, #ed5857 100%);
  color: #fff;
  font-size: 26rpx;
  box-shadow: 0 8rpx 16rpx rgba(237, 88, 87, 0.2);
}

.setting-section {
  margin-top: 18rpx;
  padding: 26rpx 22rpx;
}

.setting-heading {
  display: block;
  margin-bottom: 20rpx;
  color: #152338;
  font-size: 31rpx;
  font-weight: 700;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 164rpx;
  padding: 16rpx 4rpx;
  border: 1rpx solid #e8eef5;
  border-radius: 20rpx;
  color: #27374d;
  font-size: 24rpx;
  font-weight: 600;
}

.service-icon {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 33rpx;
  line-height: 58rpx;
  text-align: center;
}

.service-icon.blue {
  background: linear-gradient(135deg, #6b9cf8, #4c7ff0);
}

.service-icon.orange {
  background: linear-gradient(135deg, #ffad55, #f47d38);
}

.service-icon.green {
  background: linear-gradient(135deg, #45c99b, #1fae78);
}

.service-icon.purple {
  background: linear-gradient(135deg, #9c84f5, #765be2);
}

.service-sub {
  margin-top: 8rpx;
  color: #8b99ab;
  font-size: 19rpx;
  font-weight: 400;
}

.config-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #edf1f6;
  color: #34445a;
  font-size: 25rpx;
}

.config-row input {
  flex: 1;
  margin-left: 20rpx;
  color: #64758b;
  font-size: 23rpx;
  text-align: right;
}

.config-value {
  margin-left: auto;
  color: #8998aa;
}

.outline-button,
.danger-button {
  margin-top: 16rpx;
  border: 1rpx solid #dce5ef;
  border-radius: 34rpx;
  background: #f9fbfd;
  color: #5b6b80;
  font-size: 24rpx;
}

.primary-button {
  margin-top: 20rpx;
}

.danger-button {
  border-color: #ffd0cd;
  background: #fff8f7;
  color: #e65551;
}

.follow-card {
  margin-top: 18rpx;
  padding: 32rpx 22rpx;
  text-align: center;
}

.follow-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

.follow-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b8ba1;
  font-size: 23rpx;
}

.follow-placeholder {
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx auto 16rpx;
  border: 2rpx dashed #cbd7e5;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #9aa8b9;
  font-size: 25rpx;
}

.follow-tip {
  color: #7b8ba1;
  font-size: 23rpx;
}

.bottom-space {
  height: 150rpx;
}
