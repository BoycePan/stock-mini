.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 12rpx 24rpx 0;
}

.theme-card,
.promo-card,
.setting-section,
.follow-card {
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.theme-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 24rpx;
}

.theme-copy {
  display: flex;
  align-items: center;
  min-width: 0;
}

.theme-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  border-radius: 21rpx;
  background: linear-gradient(145deg, #eaf2ff 0%, #dce9ff 100%);
  color: #4c7ff5;
  font-size: 40rpx;
}

.theme-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

.theme-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #7b8ba1;
  font-size: 23rpx;
}

.theme-switch {
  display: flex;
  flex: 0 0 auto;
  padding: 6rpx;
  border-radius: 34rpx;
  background: #eef3f8;
}

.theme-option {
  padding: 14rpx 16rpx;
  border-radius: 27rpx;
  color: #65748a;
  font-size: 23rpx;
}

.theme-option.selected {
  background: #fff;
  color: #4278ed;
  box-shadow: 0 5rpx 14rpx rgba(76, 127, 255, 0.14);
}

.promo-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 30rpx 26rpx;
  border-color: #ffd5d1;
  background: linear-gradient(135deg, #fff8f6 0%, #fff1ef 100%);
}

.promo-title {
  display: block;
  color: #793d3a;
  font-size: 29rpx;
  font-weight: 700;
}

.promo-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #a06e6a;
  font-size: 23rpx;
}

.promo-button {
  min-width: 142rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ff776f 0%, #ed5857 100%);
  color: #fff;
  font-size: 26rpx;
  box-shadow: 0 8rpx 16rpx rgba(237, 88, 87, 0.2);
}

.setting-section {
  margin-top: 18rpx;
  padding: 26rpx 22rpx;
}

.setting-heading {
  display: block;
  margin-bottom: 20rpx;
  color: #152338;
  font-size: 31rpx;
  font-weight: 700;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 164rpx;
  padding: 16rpx 4rpx;
  border: 1rpx solid #e8eef5;
  border-radius: 20rpx;
  color: #27374d;
  font-size: 24rpx;
  font-weight: 600;
}

.service-icon {
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  color: #fff;
  font-size: 33rpx;
  line-height: 58rpx;
  text-align: center;
}

.service-icon.blue {
  background: linear-gradient(135deg, #6b9cf8, #4c7ff0);
}

.service-icon.orange {
  background: linear-gradient(135deg, #ffad55, #f47d38);
}

.service-icon.green {
  background: linear-gradient(135deg, #45c99b, #1fae78);
}

.service-icon.purple {
  background: linear-gradient(135deg, #9c84f5, #765be2);
}

.service-sub {
  margin-top: 8rpx;
  color: #8b99ab;
  font-size: 19rpx;
  font-weight: 400;
}

.follow-card {
  margin-top: 18rpx;
  padding: 32rpx 22rpx;
  text-align: center;
}

.follow-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

.follow-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7b8ba1;
  font-size: 23rpx;
}

.follow-placeholder {
  width: 280rpx;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx auto 16rpx;
  border: 2rpx dashed #cbd7e5;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #9aa8b9;
  font-size: 25rpx;
}

.follow-tip {
  color: #7b8ba1;
  font-size: 23rpx;
}

.bottom-space {
  height: 150rpx;
}

.service-item-hover {
  opacity: 0.72;
}

.page.theme-dark .theme-icon {
  border: 1rpx solid #34465e;
  background: #223248;
  color: #6fa3ff;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(64, 86, 116, 0.08);
}

.user-guest {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #eef3f8;
}

.user-avatar.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b8ba1;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.user-name {
  display: block;
  overflow: hidden;
  color: #152338;
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b8ba1;
  font-size: 22rpx;
}

.logout-button {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid #eb514d;
  border-radius: 30rpx;
  background: transparent;
  color: #eb514d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.logout-button::after {
  border: 0;
}

.page.theme-dark .user-card {
  border-color: #2a394e;
  background: #1a2637;
}

.page.theme-dark .user-avatar {
  background: #223248;
}

.page.theme-dark .user-avatar.avatar-placeholder {
  color: #9cacc0;
}

.page.theme-dark .user-name {
  color: #f5f7fb;
}

.page.theme-dark .user-meta {
  color: #9cacc0;
}

.page.theme-dark .logout-button {
  border-color: #eb514d;
  color: #eb514d;
}
