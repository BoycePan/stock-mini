/* ============ 滚动区 ============ */
.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx 0;
}

/* ============ 用户卡片 ============ */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 36rpx rgba(30, 60, 110, 0.14);
}

.user-guest {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar-ring {
  flex: 0 0 auto;
  padding: 4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b9cf8 0%, #9c84f5 100%);
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  display: block;
  border-radius: 50%;
  background: #eef3f8;
}

.user-avatar.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7b8ba1;
  font-size: 48rpx;
}

.user-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.user-name {
  display: block;
  overflow: hidden;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-meta {
  display: block;
  margin-top: 8rpx;
  color: #7b8ba1;
  font-size: 22rpx;
}

.user-status {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.user-status.online {
  background: #e6f7ee;
  color: #1fae78;
}

.user-status.offline {
  background: #eef3f8;
  color: #8a98aa;
}

/* ============ 上线公告横幅 ============ */
.banner {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #dbe7f8;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #f3f8ff 0%, #eef4ff 100%);
  box-shadow: 0 8rpx 24rpx rgba(64, 86, 116, 0.06);
}

.banner-icon {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #7db4ff 0%, #4c7ff0 100%);
  font-size: 40rpx;
}

.banner-copy {
  flex: 1;
  min-width: 0;
}

.banner-title {
  display: block;
  color: #1f3a63;
  font-size: 28rpx;
  font-weight: 700;
}

.banner-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #6a83a3;
  font-size: 22rpx;
}

.banner-badge {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ff8f6b 0%, #ff5f6d 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ============ 分组标题 ============ */
.section-heading {
  display: block;
  margin: 32rpx 14rpx 14rpx;
  color: #7d8fa6;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

/* ============ 设置分组 ============ */
.setting-group {
  border: 1rpx solid #d4dfec;
  border-radius: 32rpx;
  background: #fff;
  box-shadow:
    0 2rpx 8rpx rgba(30, 60, 110, 0.1),
    0 12rpx 32rpx rgba(30, 60, 110, 0.14);
  overflow: hidden;
}

/* ============ 设置行通用 ============ */
.setting-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  min-height: 100rpx;
  box-sizing: border-box;
}

/* 主题行：图标区 + row-main 占满剩余空间 */
.theme-row {
  gap: 0;
}

/* 可点击行 */
.setting-row.clickable {
  cursor: pointer;
}

/* ============ 图标 ============ */
.row-icon-wrap {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  border-radius: 20rpx;
  font-size: 34rpx;
}

.row-icon-wrap.theme {
  background: linear-gradient(135deg, #eaf2ff 0%, #dce9ff 100%);
  color: #4c7ff5;
}

.row-icon-wrap.blue {
  background: #e8f1ff;
}
.row-icon-wrap.orange {
  background: #fff3e8;
}
.row-icon-wrap.green {
  background: #e6f7ef;
}
.row-icon-wrap.purple {
  background: #f0ebff;
}
.row-icon-wrap.gray {
  background: #eef2f6;
}

.row-emoji {
  font-size: 34rpx;
  line-height: 1;
}

/* tdesign icon 颜色继承父容器 */
.row-icon-svg {
  color: #4c7ff5;
}

/* ============ 文字区 ============ */
.row-main {
  flex: 1;
  min-width: 0;
}

.row-label {
  display: block;
  flex: 1;
  min-width: 0;
  color: #152338;
  font-size: 30rpx;
  font-weight: 600;
}

.row-desc {
  display: block;
  margin-top: 6rpx;
  color: #8b99ab;
  font-size: 22rpx;
}

/* ============ 右侧装饰 ============ */
/* tdesign chevron-right icon */
.row-arrow-icon {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #c3cdd9 !important;
}

.row-value {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #8b99ab;
  font-size: 26rpx;
}

/* ============ 分割线 ============ */
.row-divider {
  height: 1rpx;
  margin-left: 122rpx;
  background: #edf1f6;
}

/* ============ 主题切换 ============ */
.theme-switch {
  display: flex;
  flex: 0 0 auto;
  padding: 5rpx;
  border-radius: 32rpx;
  background: #eef3f8;
}

.theme-option {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  color: #65748a;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.theme-option.selected {
  background: #fff;
  color: #4278ed;
  font-weight: 700;
  transform: scale(1.02);
  box-shadow: 0 4rpx 14rpx rgba(76, 127, 255, 0.18);
}

/* ============ 环境状态 pill ============ */
.env-pill {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.env-pill-prod {
  background: #eef3f8;
  color: #8a98aa;
}

.env-pill-dev {
  background: #fff3e8;
  color: #f07430;
}

/* ============ 页脚 ============ */
.footer {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #edf1f6;
  text-align: center;
}

.footer-title {
  display: block;
  color: #9aa8b9;
  font-size: 24rpx;
  font-weight: 600;
}

.footer-sub {
  display: block;
  margin-top: 8rpx;
  color: #b3bfcc;
  font-size: 20rpx;
}

/* ============ 通用交互 ============ */
.row-hover {
  opacity: 0.72;
  transform: scale(0.99);
}

.bottom-space {
  height: 150rpx;
}

/* ============================================================
   深色主题
   ============================================================ */
.page.theme-dark .user-card,
.page.theme-dark .setting-group {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.14),
    0 8rpx 32rpx rgba(0, 0, 0, 0.22);
}

.page.theme-dark .avatar-ring {
  background: linear-gradient(135deg, #3a6bd0 0%, #765be2 100%);
}

.page.theme-dark .user-avatar {
  background: #223248;
}

.page.theme-dark .user-avatar.avatar-placeholder {
  color: #9cacc0;
}

.page.theme-dark .user-name,
.page.theme-dark .row-label {
  color: #f5f7fb;
}

.page.theme-dark .user-meta,
.page.theme-dark .row-desc {
  color: #9cacc0;
}

.page.theme-dark .user-status.online {
  background: #1d3a2e;
  color: #4fd08a;
}

.page.theme-dark .user-status.offline {
  background: #223248;
  color: #9cacc0;
}

.page.theme-dark .banner {
  border-color: #2a3d55;
  background: linear-gradient(135deg, #1b2a40 0%, #1d2740 100%);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.2);
}

.page.theme-dark .banner-icon {
  background: linear-gradient(135deg, #3a6bd0 0%, #2a56b4 100%);
}

.page.theme-dark .banner-title {
  color: #e8eef7;
}
.page.theme-dark .banner-subtitle {
  color: #8fa3bd;
}

.page.theme-dark .banner-badge {
  background: linear-gradient(135deg, #d16a4e 0%, #c24552 100%);
}

.page.theme-dark .section-heading {
  color: #6a7e97;
}

.page.theme-dark .row-icon-wrap.theme {
  border: 1rpx solid #34465e;
  background: #223248;
}

.page.theme-dark .row-icon-svg {
  color: #6fa3ff;
}

.page.theme-dark .row-icon-wrap.blue {
  background: #1d3047;
}
.page.theme-dark .row-icon-wrap.orange {
  background: #3a2c20;
}
.page.theme-dark .row-icon-wrap.green {
  background: #1d352b;
}
.page.theme-dark .row-icon-wrap.purple {
  background: #2c2740;
}
.page.theme-dark .row-icon-wrap.gray {
  background: #2a3442;
}

.page.theme-dark .row-arrow-icon {
  color: #4a5c74 !important;
}

.page.theme-dark .row-value {
  color: #6f8299;
}

.page.theme-dark .row-divider {
  background: #2c3d53;
}

.page.theme-dark .theme-switch {
  background: #223248;
}

.page.theme-dark .theme-option {
  color: #9cacc0;
}

.page.theme-dark .theme-option.selected {
  border: 1rpx solid #435875;
  background: #25364d;
  color: #e8eef7;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.28);
}

.page.theme-dark .footer {
  border-top-color: #2c3d53;
}

.page.theme-dark .footer-title {
  color: #7f92a9;
}
.page.theme-dark .footer-sub {
  color: #5f7188;
}

.page.theme-dark .env-pill-prod {
  background: #223248;
  color: #6f8299;
}

.page.theme-dark .env-pill-dev {
  background: #3a2c20;
  color: #e8954a;
}
