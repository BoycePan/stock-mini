.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  padding: 0 24rpx;
}

.panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(40, 70, 120, 0.06), 0 8rpx 28rpx rgba(40, 70, 120, 0.09);
}

.panel-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  color: #17191d;
  font-size: 30rpx;
  font-weight: 700;
}

.board-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 18rpx;
  border-radius: 16rpx;
  color: #344257;
  font-size: 27rpx;
  transition: background 0.15s ease, color 0.15s ease;
}

.board-row.selected {
  background: #edf4ff;
  color: #2f6fe4;
}

.board-code {
  color: #99a6b7;
  font-size: 22rpx;
}

.member-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 6rpx;
  border-bottom: 1rpx solid #edf1f6;
}

.member-row:last-child {
  border-bottom: 0;
}

.member-info {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.member-name {
  color: #17191d;
  font-size: 28rpx;
  font-weight: 600;
}

.member-code {
  color: #99a6b7;
  font-size: 22rpx;
}

.member-quote {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  color: #344257;
  font-size: 27rpx;
}

.member-quote .up {
  color: #f04b45;
}

.member-quote .down {
  color: #2db653;
}

.member-quote .flat {
  color: #8492a5;
}

.page.theme-dark .member-quote .flat {
  color: #9cacc0;
}

.member-note {
  padding-top: 18rpx;
  color: #99a6b7;
  font-size: 22rpx;
  text-align: center;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 60rpx 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-card button {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 25rpx;
}

/* 深色主题 */
.page.theme-dark .panel {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.18), 0 8rpx 28rpx rgba(0, 0, 0, 0.22);
}

.page.theme-dark .panel-title {
  color: #f5f7fb;
}

.page.theme-dark .board-row {
  color: #c6d2e0;
}

.page.theme-dark .board-row.selected {
  background: #1e3254;
  color: #6fa3ff;
}

.page.theme-dark .board-code,
.page.theme-dark .member-code,
.page.theme-dark .member-note {
  color: #5b6a7f;
}

.page.theme-dark .member-row {
  border-bottom-color: #273349;
}

.page.theme-dark .member-name {
  color: #f5f7fb;
}

.page.theme-dark .member-quote {
  color: #c6d2e0;
}

.page.theme-dark .error-card button {
  background: #233046;
  color: #6fa3ff;
}
