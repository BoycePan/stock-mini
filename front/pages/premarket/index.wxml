<view class="page theme-{{theme}} premarket-page">
  <app-header
    title="{{title}}"
    showBack="{{true}}"
    showShare="{{false}}"
  ></app-header>
  <scroll-view scroll-y class="content-scroll">
    <view class="page-meta">
      <view class="page-status {{ statusTone }}">
        <view class="status-dot"></view>
        <text>{{ statusLabel }}</text>
      </view>
      <view class="update-time">{{ updatedLabel }}</view>
    </view>

    <loading-state
      wx:if="{{ loading }}"
      text="正在加载美股盘前行情"
      desc="正在为您同步美股盘前最新数据，请稍候…"
    ></loading-state>
    <view wx:elif="{{ error }}" class="error-card"
      ><text>{{ error }}</text><button bindtap="onRetry">重新加载</button></view
    >
    <block wx:else>
      <section-card
        wx:for="{{ sections }}"
        wx:key="id"
        section="{{ item }}"
        first="{{ index === 0 }}"
        bind:metrictap="onMetricTap"
      ></section-card>
    </block>
    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>
</view>
