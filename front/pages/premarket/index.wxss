/* 美股盘前 Demo 页面样式（纯前端，遵守 AGENTS.md 双主题规范） */

.premarket-page {
  display: flex;
  flex-direction: column;
  height: 100%;
  flex: 1;
  min-height: 0;
}

/* 内容滚动区：显式声明 height: 0 触发微信小程序 Flex 下 scroll-view 滚动 */
.content-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* 顶部信息行：状态 pill 靠左、更新时间靠右 */
.page-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx;
}

/* 交易状态 pill：盘中=绿 */
.page-status {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border: 1rpx solid #cdeedb;
  border-radius: 30rpx;
  background: #effaf3;
  color: #1c9d59;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(28, 157, 89, 0.1);
}

/* 盘前 / 盘后：蓝 */
.page-status.quiet {
  border-color: #cfe0f4;
  background: #eff5fd;
  color: #3a6ecc;
  box-shadow: 0 4rpx 12rpx rgba(58, 110, 204, 0.1);
}

/* 休市 / 周末：灰 */
.page-status.rest {
  border-color: #dce5f1;
  background: #f2f6fb;
  color: #617188;
  box-shadow: 0 4rpx 12rpx rgba(97, 113, 136, 0.08);
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #24b86b;
  box-shadow: 0 0 0 4rpx rgba(36, 184, 107, 0.14);
}

.page-status.quiet .status-dot {
  background: #4a82e0;
  box-shadow: 0 0 0 4rpx rgba(74, 130, 224, 0.16);
}

.page-status.rest .status-dot {
  background: #a5b0bf;
  box-shadow: 0 0 0 5rpx rgba(165, 176, 191, 0.14);
}

/* 数据更新时间（右对齐，长文本省略） */
.update-time {
  min-width: 0;
  margin-left: 24rpx;
  color: #8a98aa;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 错误卡片 */
.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 60rpx 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-card button {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 25rpx;
}

/* 底部占位：避免内容被悬浮 TabBar / 底部安全区遮挡 */
.bottom-space {
  height: 150rpx;
  height: calc(122rpx + env(safe-area-inset-bottom) + 24rpx);
}

/* ============ 深色主题 ============ */
.page.theme-dark .page-status {
  border-color: #2b4a3c;
  background: #1e3a2e;
  color: #6fd79a;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.page.theme-dark .page-status.quiet {
  border-color: #2b3d6a;
  background: #1d2c4a;
  color: #8fb4f5;
}

.page.theme-dark .page-status.rest {
  border-color: #2b3d57;
  background: #1d2b40;
  color: #9db4d4;
}

.page.theme-dark .status-dot {
  background: #34d37d;
  box-shadow: 0 0 0 5rpx rgba(52, 211, 125, 0.16);
}

.page.theme-dark .page-status.quiet .status-dot {
  background: #6fa3ff;
  box-shadow: 0 0 0 5rpx rgba(111, 163, 255, 0.18);
}

.page.theme-dark .page-status.rest .status-dot {
  background: #7e93b0;
  box-shadow: 0 0 0 5rpx rgba(126, 147, 176, 0.18);
}

.page.theme-dark .update-time {
  color: #9cacc0;
}

.page.theme-dark .error-card {
  color: #9cacc0;
}

.page.theme-dark .error-card button {
  background: #233046;
  color: #6fa3ff;
}
