<view class="page theme-{{ theme }} asia-page">
  <app-header showSearch="{{ true }}" showShare="{{ false }}"></app-header>
  <view class="update-time">{{updatedLabel}}</view>
  <view class="page-status {{statusTone}}">
    <text class="status-dot"></text>
    <text>{{ statusLabel }}</text>
  </view>
  <scroll-view scroll-y class="content-scroll">
    <loading-state wx:if="{{ loading }}"></loading-state>
    <view wx:elif="{{ error }}" class="error-card">
      <text>{{ error }}</text>
      <button bindtap="onRetry">重新加载</button>
    </view>
    <block wx:else>
      <section-card wx:for="{{ sections }}" wx:key="id" section="{{ item }}"></section-card>
    </block>
    <view class="bottom-space"></view>
  </scroll-view>
  <bottom-tabbar active="{{ activeTab }}" bind:change="onTabChange"></bottom-tabbar>
</view>
