<view class="page theme-{{ theme }} asia-page">
  <market-page
    showShare="{{ true }}"
    shareTitle="日韩市场行情"
    loading="{{ loading }}"
    error="{{ error }}"
    loadingText="正在加载亚太行情"
    loadingDesc="正在为您同步亚太主要市场最新数据，请稍候…"
    statusLabel="{{ statusLabel }}"
    statusTone="{{ statusTone }}"
    updatedLabel="{{ updatedLabel }}"
    sections="{{ sections }}"
    bind:retry="onRetry"
    bind:metrictap="onMetricTap"
  ></market-page>
</view>

