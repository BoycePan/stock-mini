.page-status {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  margin: 4rpx 0 8rpx 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #dce5f1;
  border-radius: 30rpx;
  background: #f2f6fb;
  color: #617188;
  font-size: 24rpx;
  font-weight: 600;
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #a5b0bf;
  box-shadow: 0 0 0 5rpx rgba(165, 176, 191, 0.14);
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.source-note {
  margin: 24rpx 40rpx;
  color: #8a98aa;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.bottom-space {
  height: 150rpx;
}

/* 深色主题 */
.page.theme-dark .page-status {
  border-color: #2b3d57;
  background: #1d2b40;
  color: #9db4d4;
}

.page.theme-dark .status-dot {
  background: #7e93b0;
  box-shadow: 0 0 0 5rpx rgba(126, 147, 176, 0.18);
}
