<view class="page theme-{{ theme }} metals-page">
  <market-page
    activeTab="{{ activeTab }}"
    loading="{{ loading }}"
    error="{{ error }}"
    loadingText="正在加载贵金属行情"
    loadingDesc="正在为您同步最新贵金属报价，请稍候…"
    statusLabel="{{ statusLabel }}"
    statusTone="{{ statusTone }}"
    updatedLabel="{{ updatedLabel }}"
    sections="{{ sections }}"
    bind:retry="onRetry"
    bind:share="onShare"
    bind:tabchange="onTabChange"
    bind:metrictap="onMetricTap"
  ></market-page>
</view>

