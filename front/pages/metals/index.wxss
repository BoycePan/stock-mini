.page-status {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  margin: 4rpx 0 8rpx 32rpx;
  padding: 10rpx 18rpx;
  border: 1rpx solid #cdeedb;
  border-radius: 30rpx;
  background: #effaf3;
  color: #1c9d59;
  font-size: 24rpx;
  font-weight: 600;
}

.status-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #24b86b;
  box-shadow: 0 0 0 5rpx rgba(36, 184, 107, 0.12);
}

.updated {
  margin-left: 16rpx;
  color: #8a98aa;
  font-weight: 400;
}

.content-scroll {
  flex: 1;
  min-height: 0;
}

.bottom-space {
  height: 150rpx;
}
