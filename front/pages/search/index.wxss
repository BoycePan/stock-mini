.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.content-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 36rpx;
  background: #ffffff;
  color: #17191d;
  font-size: 27rpx;
  box-shadow: 0 2rpx 8rpx rgba(40, 70, 120, 0.06);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.search-placeholder {
  color: #99a6b7;
}

.search-button {
  height: 72rpx;
  padding: 0 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #4c8dff 0%, #3567d6 100%);
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.content-scroll {
  flex: 1;
  padding: 0 24rpx;
}

.result-list {
  overflow: hidden;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(40, 70, 120, 0.06), 0 8rpx 28rpx rgba(40, 70, 120, 0.09);
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f4f9;
  transition: background 0.12s ease;
}

.result-row-hover {
  background: #f5f8fc;
}

.result-row:last-child {
  border-bottom: 0;
}

.result-info {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.result-name {
  color: #17191d;
  font-size: 29rpx;
  font-weight: 600;
}

.result-code {
  color: #99a6b7;
  font-size: 23rpx;
}

.result-meta {
  max-width: 240rpx;
  overflow: hidden;
  color: #718096;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-section {
  margin-top: 28rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.history-title {
  color: #17191d;
  font-size: 28rpx;
  font-weight: 600;
}

.history-clear {
  color: #718096;
  font-size: 24rpx;
  padding: 8rpx 0 8rpx 24rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.history-tag {
  padding: 14rpx 28rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 32rpx;
  background: #ffffff;
  color: #17191d;
  font-size: 25rpx;
  transition: transform 0.12s ease, background 0.12s ease;
}

.history-tag-hover {
  background: #f0f5ff;
  transform: scale(0.96);
}

.hint {
  margin-top: 120rpx;
  color: #99a6b7;
  font-size: 25rpx;
  text-align: center;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 60rpx 24rpx;
  color: #718096;
  font-size: 27rpx;
}

.error-card button {
  margin-top: 24rpx;
  border-radius: 34rpx;
  background: #edf4ff;
  color: #4278ed;
  font-size: 25rpx;
}

/* 深色主题 */
.page.theme-dark .search-input {
  border-color: #2a394e;
  background: #1c2535;
  color: #f5f7fb;
}

.page.theme-dark .result-list {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16), 0 8rpx 24rpx rgba(0, 0, 0, 0.22);
}

.page.theme-dark .result-row {
  border-bottom-color: #273349;
}

.page.theme-dark .result-name {
  color: #f5f7fb;
}

.page.theme-dark .search-placeholder,
.page.theme-dark .result-code,
.page.theme-dark .result-meta,
.page.theme-dark .hint {
  color: #9cacc0;
}

.page.theme-dark .history-title {
  color: #f5f7fb;
}

.page.theme-dark .history-clear {
  color: #9cacc0;
}

.page.theme-dark .history-tag {
  border-color: #2a394e;
  background: #1a2637;
  color: #e5ebf4;
}

.page.theme-dark .history-tag-hover {
  background: #1e3254;
}

.page.theme-dark .result-row-hover {
  background: #1e2c40;
}

.page.theme-dark .error-card button {
  background: #233046;
  color: #6fa3ff;
}
