.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 14rpx 24rpx 0;
}

/* ============ 卡片通用 ============ */
.card {
  margin-top: 22rpx;
  padding: 34rpx 32rpx 36rpx;
  border: 1rpx solid #d4dfec;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(30, 60, 110, 0.10), 0 12rpx 32rpx rgba(30, 60, 110, 0.14);
}

/* ============ 卡片标题行 ============ */
.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

/* 标题左侧竖向渐变强调条 */
.card-title-bar {
  flex: 0 0 auto;
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4278ed 0%, #96c0ff 100%);
}

.card-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
}

/* ============ 引言卡 ============ */
.intro-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.intro-icon-wrap {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(66, 120, 237, 0.14);
  border-radius: 26rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #ddeafd 100%);
  box-shadow: 0 4rpx 16rpx rgba(66, 120, 237, 0.14);
}

.intro-icon {
  font-size: 44rpx;
  line-height: 1;
}

.intro-header-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.intro-title {
  display: block;
  color: #152338;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.intro-subtitle {
  display: block;
  color: #718096;
  font-size: 24rpx;
}

.intro-divider {
  height: 1rpx;
  margin: 26rpx 0 4rpx;
  background: linear-gradient(90deg, #dde6f2 0%, transparent 80%);
}

/* 引言正文：左侧渐变强调条 */
.intro-quote {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  margin-top: 18rpx;
}

.intro-quote-bar {
  flex: 0 0 auto;
  width: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #4278ed 0%, #96c0ff 100%);
}

.intro-body {
  flex: 1;
  min-width: 0;
  display: block;
  color: #3d4c60;
  font-size: 27rpx;
  line-height: 50rpx;
  letter-spacing: 0.3rpx;
}

/* ============ 二维码卡 ============ */
.qr-wrap {
  margin-top: 26rpx;
  padding: 24rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 28rpx;
  background: #f2f6fa;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
}

.qr-image {
  width: 340rpx;
  border-radius: 16rpx;
}

.qr-error {
  padding: 44rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.qr-error-icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.qr-error-text {
  color: #718096;
  font-size: 24rpx;
}

.qr-error-retry {
  margin-top: 6rpx;
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  background: #eef3fb;
  color: #4278ed;
  font-size: 24rpx;
  font-weight: 600;
  transition:
    opacity 0.15s ease,
    transform 0.15s ease;
}

.qr-error-retry-hover {
  opacity: 0.72;
  transform: scale(0.95);
}

.qr-hint {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: #718096;
  font-size: 24rpx;
  line-height: 38rpx;
}

.qr-note {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f5f9fd 0%, #edf3fa 100%);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.qr-note-icon {
  flex: 0 0 auto;
  font-size: 26rpx;
  line-height: 40rpx;
}

.qr-note-text {
  flex: 1;
  min-width: 0;
  color: #4a5a70;
  font-size: 23rpx;
  line-height: 40rpx;
}

/* ============ 反馈小贴士 ============ */
.tip-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 24rpx;
}

.tip-num {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 1rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4278ed 0%, #6fa3ff 100%);
  box-shadow: 0 4rpx 10rpx rgba(66, 120, 237, 0.22);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.tip-text {
  flex: 1;
  min-width: 0;
  color: #4a5a70;
  font-size: 24rpx;
  line-height: 44rpx;
}

/* ============ 页脚留白 ============ */
.bottom-space {
  height: 96rpx;
}

/* ============================================================
   深色主题
   ============================================================ */
.page.theme-dark .card {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.22);
}

.page.theme-dark .card-title-bar {
  background: linear-gradient(180deg, #6fa3ff 0%, #3160c4 100%);
}

.page.theme-dark .card-title {
  color: #f5f7fb;
}


.page.theme-dark .intro-icon-wrap {
  border-color: rgba(111, 163, 255, 0.18);
  background: linear-gradient(135deg, #1d3252 0%, #192b46 100%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.25);
}

.page.theme-dark .intro-title {
  color: #f5f7fb;
}

.page.theme-dark .intro-subtitle,
.page.theme-dark .qr-hint,
.page.theme-dark .qr-error-text {
  color: #9cacc0;
}

.page.theme-dark .intro-body,
.page.theme-dark .qr-note-text,
.page.theme-dark .tip-text {
  color: #b8ccdf;
}

.page.theme-dark .intro-divider {
  background: linear-gradient(90deg, #2a394e 0%, transparent 80%);
}

.page.theme-dark .intro-quote-bar {
  background: linear-gradient(180deg, #4278ed 0%, #3160c4 100%);
}

/* 二维码容器保持白底，保证扫码识别率（与卡片背景无关） */
.page.theme-dark .qr-wrap {
  border-color: #34465e;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.28);
}

/* 白底容器内的提示文字用深色，保证深色主题下仍可读 */
.page.theme-dark .qr-wrap .qr-error-text {
  color: #718096;
}

.page.theme-dark .qr-error-retry {
  background: #223248;
  color: #6fa3ff;
}

.page.theme-dark .qr-note {
  border-color: #34465e;
  background: linear-gradient(135deg, #1d3047 0%, #223248 100%);
}

.page.theme-dark .tip-num {
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.3);
}