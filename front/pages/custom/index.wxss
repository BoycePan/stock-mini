.content-scroll {
  flex: 1;
  min-height: 0;
  padding: 14rpx 24rpx 0;
}

/* ============ 卡片通用 ============ */
.card {
  margin-top: 20rpx;
  padding: 34rpx 32rpx 36rpx;
  border: 1rpx solid #e2eaf3;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 6rpx 28rpx rgba(64, 86, 116, 0.07);
}

/* ============ 引言卡 ============ */
.intro-header {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.intro-icon-wrap {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #eef4ff 0%, #ddeafd 100%);
  box-shadow: 0 4rpx 16rpx rgba(66, 120, 237, 0.14);
}

.intro-icon {
  font-size: 44rpx;
  line-height: 1;
}

.intro-header-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.intro-title {
  display: block;
  color: #152338;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.intro-subtitle {
  display: block;
  color: #718096;
  font-size: 24rpx;
}

.intro-divider {
  height: 1rpx;
  margin: 26rpx 0 4rpx;
  background: linear-gradient(90deg, #dde6f2 0%, transparent 80%);
}

.intro-body {
  display: block;
  margin-top: 16rpx;
  color: #3d4c60;
  font-size: 27rpx;
  line-height: 50rpx;
  letter-spacing: 0.3rpx;
}

/* ============ 卡片标题 ============ */
.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  display: block;
  color: #152338;
  font-size: 32rpx;
  font-weight: 700;
}

/* ============ 二维码卡 ============ */
.qr-wrap {
  margin-top: 26rpx;
  padding: 26rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
}

.qr-image {
  width: 420rpx;
  border-radius: 12rpx;
}

.qr-error {
  padding: 44rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.qr-error-icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.qr-error-text {
  color: #718096;
  font-size: 24rpx;
}

.qr-error-retry {
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  background: #eef3fb;
  color: #4278ed;
  font-size: 24rpx;
  font-weight: 600;
}

.qr-hint {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: #718096;
  font-size: 24rpx;
}

.qr-note {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f2f6fa;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.qr-note-icon {
  flex: 0 0 auto;
  font-size: 26rpx;
  line-height: 40rpx;
}

.qr-note-text {
  flex: 1;
  min-width: 0;
  color: #4a5a70;
  font-size: 23rpx;
  line-height: 40rpx;
}

/* ============ 反馈小贴士 ============ */
.tip-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.tip-line + .tip-line {
  margin-top: 18rpx;
}

.tip-dot {
  flex: 0 0 auto;
  color: #4278ed;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.tip-text {
  flex: 1;
  min-width: 0;
  color: #4a5a70;
  font-size: 24rpx;
  line-height: 42rpx;
}

/* ============ 页脚留白 ============ */
.bottom-space {
  height: 80rpx;
}

/* ============================================================
   深色主题
   ============================================================ */
.page.theme-dark .card {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.22);
}

.page.theme-dark .intro-icon-wrap {
  background: linear-gradient(135deg, #1d3252 0%, #192b46 100%);
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.25);
}

.page.theme-dark .intro-title,
.page.theme-dark .card-title {
  color: #f5f7fb;
}

.page.theme-dark .intro-subtitle,
.page.theme-dark .qr-hint,
.page.theme-dark .qr-error-text {
  color: #9cacc0;
}

.page.theme-dark .intro-body,
.page.theme-dark .qr-note-text,
.page.theme-dark .tip-text {
  color: #b8ccdf;
}

.page.theme-dark .intro-divider {
  background: linear-gradient(90deg, #2a394e 0%, transparent 80%);
}

/* 二维码容器保持白底，保证扫码识别率（与卡片背景无关） */
.page.theme-dark .qr-wrap {
  border-color: #34465e;
  background: #fff;
}

.page.theme-dark .qr-error-retry {
  background: #223248;
  color: #6fa3ff;
}

.page.theme-dark .qr-note {
  background: #223248;
}

.page.theme-dark .tip-dot {
  color: #6fa3ff;
}
