<view class="page theme-{{ theme }} finance-page">
  <app-header showSearch="{{ true }}" showShare="{{ false }}"></app-header>
  <view class="page-meta">
    <view class="page-status">
      <text class="status-dot"></text>
      <text>{{ statusLabel }}</text>
    </view>
    <view class="update-time">{{ updatedLabel }}</view>
  </view>
  <scroll-view
    scroll-y
    class="content-scroll"
    refresher-enabled="{{ true }}"
    refresher-triggered="{{ refreshing }}"
    refresher-default-style="{{ theme === 'dark' ? 'white' : 'black' }}"
    refresher-background="{{ theme === 'dark' ? '#151e2d' : '#eef3f8' }}"
    bindrefresherrefresh="onRefresherRefresh"
    bindscroll="onScroll"
    bindscrolltolower="onScrollLower"
    lower-threshold="150"
    scroll-top="{{ scrollTop }}"
  >
    <loading-state
      wx:if="{{ loading }}"
      text="正在加载财经资讯"
      desc="正在为您获取最新财经快讯，请稍候…"
    ></loading-state>

    <view wx:elif="{{ error }}" class="error-card">
      <text>{{ error }}</text>
      <button bindtap="onRetry">重新加载</button>
    </view>
    <block wx:else>
      <view wx:if="{{ news.length }}" class="news-list">
        <view
          wx:for="{{ news }}"
          wx:key="key"
          class="news-item {{ item.flash ? 'news-item-flash' : '' }}"
          hover-class="news-item-hover"
          data-index="{{ index }}"
          bindtap="onItemTap"
        >
          <view class="news-head">
            <text class="news-title">{{ item.title }}</text>
            <text wx:if="{{ item.flash }}" class="flash-badge">快讯</text>
          </view>
          <text wx:if="{{ item.summary }}" class="news-intro">{{ item.summary }}</text>
          <view class="news-meta">
            <view class="meta-source">
              <text class="meta-dot {{ item.flash ? 'meta-dot-flash' : '' }}"></text>
              <text wx:if="{{ item.source }}" class="news-source">{{ item.source }}</text>
            </view>
            <text wx:if="{{ item.timeText || item.time }}" class="news-time">{{
              item.timeText || item.time
            }}</text>
          </view>
        </view>
        <!-- 滚动加载 footer：触底自动加载，也可点击手动加载 -->
        <view class="load-more {{ hasMore ? '' : 'end' }}" bindtap="onLoadMore">
          {{ loadingMore ? '加载中…' : hasMore ? '加载更多' : '没有更多了' }}
        </view>
      </view>
      <view wx:else class="empty-hint">暂无新闻</view>
    </block>
    <disclaimer-footer></disclaimer-footer>
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 悬浮刷新按钮组件：轮询发现最新新闻时由页面驱动显示（淡入/淡出动画在组件内），点击触发下拉刷新 -->
  <refresh-btn id="refresh-btn" bind:refresh="onRefreshBtnRefresh"></refresh-btn>
  <!-- 回到顶部按钮组件：滚动超过一屏且停止滚动后显示；刷新按钮显示时自动隐藏，点击回到顶部 -->
  <back-to-top id="back-to-top" bind:totop="onBackToTop"></back-to-top>
</view>
