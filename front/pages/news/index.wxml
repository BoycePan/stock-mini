<view class="page theme-{{theme}}">
  <app-header title="{{title}}" showShare="{{false}}"></app-header>
  <scroll-view scroll-y class="content-scroll">
    <view wx:if="{{loading}}" class="loading">加载中…</view>
    <view wx:elif="{{error}}" class="error">{{error}}</view>
    <block wx:else>
      <view wx:if="{{items.length}}" class="news-list">
        <view
          wx:for="{{items}}"
          wx:key="title"
          class="news-item"
          data-url="{{item.url}}"
          bindtap="onItemTap"
        >
          <text class="news-title">{{item.title}}</text>
          <text class="news-intro">{{item.summary}}</text>
          <text class="news-meta">{{item.source}} {{item.time}}</text>
        </view>
      </view>
      <empty-state wx:else title="暂无新闻"></empty-state>
    </block>
  </scroll-view>
</view>
