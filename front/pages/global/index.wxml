<view class="page theme-{{ theme }} global-page">
  <market-page
    showShare="{{ true }}"
    loading="{{ loading }}"
    error="{{ error }}"
    loadingText="正在加载全球行情"
    loadingDesc="正在为您同步全球主要市场最新数据，请稍候…"
    statusLabel="{{ statusLabel }}"
    statusTone="{{ statusTone }}"
    updatedLabel="{{ updatedLabel }}"
    sections="{{ sections }}"
    bind:retry="onRetry"
    bind:share="onShare"
    bind:metrictap="onMetricTap"
  ></market-page>
</view>

