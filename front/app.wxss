@import './styles/font.wxss';

page {
  background: #e8eef6;
  color: #142033;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

view,
text,
scroll-view,
button,
input,
switch {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #eef3f9 0%, #e4ecf5 55%, #dde7f2 100%);
  color: #142033;
}

.page.theme-dark {
  background: linear-gradient(180deg, #111827 0%, #151e2d 52%, #101722 100%);
  color: #f5f7fb;
}

.page.theme-dark .header,
.page.theme-dark .share-button,
.page.theme-dark .tabbar {
  background: rgba(24, 34, 49, 0.96);
  border-color: #2a394e;
  color: #f5f7fb;
}

.page.theme-dark .back-button {
  border-color: #2a394e;
  background: rgba(24, 34, 49, 0.96);
  color: #e8eef7;
}

.page.theme-dark .brand-mark {
  border-color: #38516e;
  background: #1d3047;
  color: #6eb7ff;
}

.page.theme-dark .brand-title,
.page.theme-dark .section-title,
.page.theme-dark .stock-name,
.page.theme-dark .price,
.page.theme-dark .panel-title,
.page.theme-dark .news-title,
.page.theme-dark .metric-value,
.page.theme-dark .market-value {
  color: #f5f7fb;
}

.page.theme-dark .section-card,
.page.theme-dark .quote-card,
.page.theme-dark .panel,
.page.theme-dark .error-card,
.page.theme-dark .news-list,
.page.theme-dark .loading,
.page.theme-dark .error {
  border-color: #2a394e;
  background: #1a2637;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.page.theme-dark .metric-card,
.page.theme-dark .theme-switch,
.page.theme-dark .market-card {
  border-color: #34465e;
  background: #223248;
  color: #f5f7fb;
}

.page.theme-dark .metric-name,
.page.theme-dark .quote-grid text:last-child,
.page.theme-dark .member-row,
.page.theme-dark .board-row {
  color: #e5ebf4;
}

.page.theme-dark .update-time,
.page.theme-dark .news-time,
.page.theme-dark .news-meta,
.page.theme-dark .quote-grid text:first-child,
.page.theme-dark .stock-code,
.page.theme-dark .kline-row,
.page.theme-dark .news-intro {
  color: #9cacc0;
}

.page.theme-dark .theme-option.selected {
  border-color: #435875;
  background: #25364d;
  color: #e8eef7;
}

.page.theme-dark .title-accent {
  box-shadow: 0 0 16rpx rgba(77, 150, 255, 0.35);
}

.page.theme-dark .section-badge {
  border-color: #7d4a56;
  background: #382a34;
  color: #ff9b9a;
}

.page.theme-dark .news-item,
.page.theme-dark .news-row,
.page.theme-dark .kline-row,
.page.theme-dark .board-row,
.page.theme-dark .member-row {
  border-color: #2c3d53;
}

/* ============ 骨架屏脉冲动画（全局可用） ============ */
@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.45;
  }
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

.loading-skeleton {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e2eaf3 25%, #eef3f8 50%, #e2eaf3 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.6s ease-in-out infinite;
}

.page.theme-dark .loading-skeleton {
  background: linear-gradient(90deg, #1c2b3e 25%, #243447 50%, #1c2b3e 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.6s ease-in-out infinite;
}

/* ============ 全局可点击行 press 态 ============ */
.press-scale {
  transition:
    transform 0.12s ease,
    opacity 0.12s ease;
}

.press-scale:active {
  transform: scale(0.97);
  opacity: 0.8;
}
